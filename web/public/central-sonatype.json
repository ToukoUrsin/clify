{"ok":true,"site":"central-sonatype","host":"central.sonatype.com","about":"Maven Central (central.sonatype.com): search Maven components, browse namespaces and categories, and look up artifact details, versions, dependencies and dependents via the site's internal JSON API.","commands":[{"command":"search-components","summary":"Keyword search over Maven Central components (groupId/artifactId); returns latest version, description, popularity","params":[{"name":"query","type":"string","required":true,"description":"Search keywords, e.g. an artifact or library name"},{"name":"page","type":"number","description":"0-based page number","default":0},{"name":"size","type":"number","description":"Results per page","default":10}],"exampleUrl":"https://clify-dev.netlify.app/central-sonatype/search-components?query=jackson"},{"command":"list-namespace-components","summary":"List all components (artifacts) published under a Maven namespace/groupId, optionally narrowed by keyword","params":[{"name":"namespace","type":"string","required":true,"description":"Maven groupId, e.g. com.google.guava"},{"name":"query","type":"string","description":"Optional keyword to narrow results within the namespace"},{"name":"page","type":"number","description":"0-based page number","default":0},{"name":"size","type":"number","description":"Results per page","default":10}],"exampleUrl":"https://clify-dev.netlify.app/central-sonatype/list-namespace-components?namespace=com.google.guava"},{"command":"search-components-by-category","summary":"Search or browse components within a category (e.g. JSON, Web Frameworks, Testing)","params":[{"name":"category","type":"string","required":true,"description":"Category name as shown on the site, e.g. JSON, Web Frameworks, Data Processors"},{"name":"query","type":"string","description":"Optional keyword; empty string browses the whole category"},{"name":"page","type":"number","description":"0-based page number","default":0},{"name":"size","type":"number","description":"Results per page","default":10}],"exampleUrl":"https://clify-dev.netlify.app/central-sonatype/search-components-by-category?category=JSON&query=json"},{"command":"get-component","summary":"Get full details of one artifact version: description, licenses, URLs (scm/issues), files, classifiers, categories, popularity","params":[{"name":"namespace","type":"string","required":true,"description":"Maven groupId"},{"name":"name","type":"string","required":true,"description":"Maven artifactId"},{"name":"version","type":"string","required":true,"description":"Exact version (get it from search-components latestVersionInfo.version or list-versions)"}],"exampleUrl":"https://clify-dev.netlify.app/central-sonatype/get-component?namespace=com.fasterxml.jackson.core&name=jackson-databind&version=2.22.4"},{"command":"list-versions","summary":"List all published versions of an artifact (newest first by default) with publish dates and dependent counts","params":[{"name":"namespace","type":"string","required":true,"description":"Maven groupId"},{"name":"name","type":"string","required":true,"description":"Maven artifactId"},{"name":"sortDirection","type":"string","description":"Version sort order","oneOf":["desc","asc"],"default":"desc"},{"name":"page","type":"number","description":"0-based page number","default":0},{"name":"size","type":"number","description":"Results per page","default":12}],"exampleUrl":"https://clify-dev.netlify.app/central-sonatype/list-versions?namespace=com.fasterxml.jackson.core&name=jackson-databind"},{"command":"list-dependencies","summary":"List the dependencies of a specific artifact version (direct or transitive), with scope and versions","params":[{"name":"namespace","type":"string","required":true,"description":"Maven groupId"},{"name":"name","type":"string","required":true,"description":"Maven artifactId"},{"name":"version","type":"string","required":true,"description":"Exact version"},{"name":"type","type":"string","description":"Dependency relationship: DIRECT or INDIRECT (transitive)","oneOf":["DIRECT","INDIRECT"],"default":"DIRECT"},{"name":"query","type":"string","description":"Optional keyword to filter dependencies"},{"name":"page","type":"number","description":"0-based page number","default":0},{"name":"size","type":"number","description":"Results per page","default":10}],"exampleUrl":"https://clify-dev.netlify.app/central-sonatype/list-dependencies?namespace=com.fasterxml.jackson.core&name=jackson-databind&version=2.22.4"},{"command":"list-dependents","summary":"List artifacts that depend on a specific artifact version (reverse dependencies)","params":[{"name":"namespace","type":"string","required":true,"description":"Maven groupId"},{"name":"name","type":"string","required":true,"description":"Maven artifactId"},{"name":"version","type":"string","required":true,"description":"Exact version"},{"name":"type","type":"string","description":"Dependency relationship: DIRECT or INDIRECT (transitive)","oneOf":["DIRECT","INDIRECT"],"default":"DIRECT"},{"name":"query","type":"string","description":"Optional keyword to filter dependents"},{"name":"page","type":"number","description":"0-based page number","default":0},{"name":"size","type":"number","description":"Results per page","default":10}],"exampleUrl":"https://clify-dev.netlify.app/central-sonatype/list-dependents?namespace=com.fasterxml.jackson.core&name=jackson-databind&version=2.22.4"},{"command":"get-homepage-url","summary":"Get the project homepage URL for an artifact version given its package URL (purl)","params":[{"name":"purl","type":"string","required":true,"description":"Package URL: pkg:maven/{groupId}/{artifactId}@{version}"}],"exampleUrl":"https://clify-dev.netlify.app/central-sonatype/get-homepage-url?purl=pkg%3Amaven%2Fcom.google.guava%2Fguava%4033.7.2-jre"}]}