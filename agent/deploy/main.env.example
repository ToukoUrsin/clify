# Main agent (Primitive). No secrets here: keys and sessions are in $CLIFY_HOME/vault.enc.
CLIFY_AGENT_ROLE=main
CLIFY_HOME=/data/home/.clify-agent
CLIFY_AGENT_ADDRESS=clify@fine-vale.primitive.email
CLIFY_AGENT_PEER=clify-agent-b3d326@inkboxmail.com
CLIFY_AGENT_HUMAN=you@example.com
CLIFY_AGENT_HUMAN_TAG=[clify test, no reply needed]
# Tiers (src/policy.ts). Owners (DMARC pass) get full power; with PUBLIC=1 any other
# DMARC-verified sender gets read-only jobs on the built-in public sites, answered in its thread.
CLIFY_AGENT_OWNERS=you@example.com
CLIFY_AGENT_PUBLIC=1
CLIFY_AGENT_PUBLIC_HOME=/data/home/.clify-public
# Public caps per UTC day: jobs and emails per sender, public jobs overall, mails to one sender.
CLIFY_AGENT_CAP_SENDER_JOBS=5
CLIFY_AGENT_CAP_SENDER_MSGS=20
CLIFY_AGENT_CAP_GLOBAL_JOBS=150
CLIFY_AGENT_CAP_SENDER_OUT=20
CLIFY_AGENT_CAP_THREAD_MSGS=10
# Who it may email besides people who wrote to it first; capped addresses get at most N mails, and only with the tag.
CLIFY_AGENT_SEND_TO=clify-agent-b3d326@inkboxmail.com,you@example.com
CLIFY_AGENT_CAPPED=
CLIFY_AGENT_CAPPED_TAG=[clify test, no reply needed]
# Writes (--yes) only on its own accounts here, and only in owner jobs.
CLIFY_AGENT_WRITE_SITES=updown,healthchecks
# The LLM bridge (bridge/sandbox-end.mjs); the real key stays on the box end.
ANTHROPIC_BASE_URL=http://127.0.0.1:18318
ANTHROPIC_API_KEY=bridge
CLIFY_CHROME=/usr/bin/chromium
INSTABOX_HEADLESS=1
