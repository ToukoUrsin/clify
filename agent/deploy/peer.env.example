# Peer agent (Inkbox mailbox). Its vault holds only the Inkbox key.
CLIFY_AGENT_ROLE=peer
CLIFY_HOME=/data/home/.clify-peer
CLIFY_AGENT_ACCEPT=clify@fine-vale.primitive.email
CLIFY_AGENT_SEND_TO=clify@fine-vale.primitive.email
ANTHROPIC_BASE_URL=http://127.0.0.1:18318
ANTHROPIC_API_KEY=bridge
CLIFY_CHROME=/usr/bin/chromium
INSTABOX_HEADLESS=1
