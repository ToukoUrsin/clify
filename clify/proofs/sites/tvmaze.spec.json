 "description": "TVmaze is a TV show database and guide. This CLI uses its free public JSON API (api.tvmaze.com) to search shows and people, look up shows by external IDs, and fetch show details, episodes, seasons, cast, crew, alternate titles, images, characters, person credits, TV and streaming schedules, and recent show updates.",
 "commands": [
  {
   "name": "search-shows",
   "summary": "Fuzzy-search shows by name; returns scored matches with full show objects",
   "method": "GET",
   "urlTemplate": "https://api.tvmaze.com/search/shows",
   "params": [
    {
     "name": "q",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Show name or keywords",
     "example": "breaking bad"
    }
   ],
   "responseType": "json",
   "defaultFields": [
    "score",
    "show.id",
    "show.name",
    "show.premiered",
    "show.ended",
    "show.status",
    "show.network.name",
    "show.webChannel.name"
   ],
   "mutates": false,
   "example": {
    "q": "breaking bad"
   },
   "source": "E17 E15 GET https://www.tvmaze.com/api",
   "verified": true
  },
