 "blockers": [],
 "notes": [
  "Keyword search (/search, /search/json) and the JSON API (/json/2.0/*) are disallowed by robots.txt. Find things through the letter listings, topics and contributors instead.",
  "Package keys are the last segment of /pkg/{key} URLs. They are lowercase and may differ from display names (e.g. T1Subset -> t1subset).",
  "Package lists give names and URLs only. In the HTML, the one-line descriptions sit in sibling div.dd elements and cannot be paired with each package.",
  "list-package-comments returns the commenter, profile link and date. The comment text sits in a sibling <p> and is not extracted.",
  "The offset parameter of list-package-comments is a page index (0, 1, 2, ...), not an item offset.",
  "get-package-rating returns per-star vote counts. The average is shown on the page as text like '\u2205 4.97 [30 votes]'.",
  "Archive file URLs point to mirrors.ctan.org for download. get-archive-directory also gives a zip of the whole directory.",
  "Related packages (/recommendations/{pkg}) and RSS/Atom feeds (/ctan-ann/rss/{pkg}.xml, /ctan-ann/atom) exist, but their response structure was not recorded.",
  "Voting and commenting require a logged-in account and are not covered."
 ],
