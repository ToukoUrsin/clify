  {
   "name": "get-skater-leaders",
   "summary": "Top-10 skater leaders for points, goals or assists in a season (optionally rookies or defensemen only)",
   "method": "GET",
   "urlTemplate": "https://api.nhle.com/stats/rest/en/leaders/skaters/{stat}",
   "params": [
    {
     "name": "stat",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Leader category",
     "enum": [
      "points",
      "goals",
      "assists"
     ],
     "example": "points"
    },
    {
     "name": "cayenneExp",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Cayenne filter expression. Season is an 8-digit id like 20262027; gameType 2=regular season, 3=playoffs. You can append \"and isRookie = 'Y'\" or \"and player.positionCode = 'D'\".",
     "default": "season=20262027 and gameType=2",
     "example": "season=20262027 and gameType=2 and isRookie = 'Y'"
    }
   ],
   "responseType": "json",
   "resultPath": "data",
   "defaultFields": [
    "player.id",
    "player.fullName",
    "player.positionCode",
    "team.triCode",
    "points",
    "goals",
    "assists"
   ],
   "mutates": false,
   "example": {
    "stat": "points"
   },
   "source": "E2 E3 E4 GET https://api.nhle.com/stats/rest/en/leaders/skaters/points",
   "verified": true
  },
