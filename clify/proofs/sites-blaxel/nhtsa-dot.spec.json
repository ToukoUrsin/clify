 "description": "NHTSA vPIC (Product Information Catalog and Vehicle Listing): decode VINs and WMIs, look up makes, models and manufacturers through the public vPIC REST API, browse Canadian Vehicle Specifications, list approved replica manufacturers, and view MID manufacturer and vehicle-modifier detail pages.",
 "commands": [
  {
   "name": "decode-vin",
   "summary": "Decode a full or partial VIN (use * as a wildcard) into a flat record with make, model, year, body, engine, safety equipment, plant and more",
   "method": "GET",
   "urlTemplate": "/api/vehicles/decodevinvalues/{vin}?format=json",
   "params": [
    {
     "name": "vin",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "17-character VIN or partial VIN; use * for unknown positions, e.g. 5UXWX7C5*BA",
     "example": "1HGCM82633A004352"
    },
    {
     "name": "modelyear",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Model year. Recommended for partial VINs; when set it overrides the year decoded from the VIN",
     "example": "2011"
    }
   ],
   "responseType": "json",
   "resultPath": "Results",
   "defaultFields": [
    "Make",
    "Model",
    "ModelYear",
    "Trim",
    "BodyClass",
    "VehicleType",
    "Manufacturer",
    "ErrorText"
   ],
   "mutates": false,
   "example": {
    "vin": "1HGCM82633A004352"
   },
   "source": "E6 E9 GET https://vpic.nhtsa.dot.gov/api/vehicles/decodevinvalues/{id}",
   "verified": true
  },
