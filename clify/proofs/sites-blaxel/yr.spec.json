 "description": "yr.no (Norwegian Meteorological Institute / NRK weather service): search places and get forecasts, current weather, nowcasts, long-range, coastal/tide/water-level, air quality, aurora, sun/moon, observation history, warnings, mountain pass conditions and meteorologist posts via yr.no's public /api/v0 JSON API.",
 "commands": [
  {
   "name": "search-locations",
   "summary": "Search places worldwide by name; returns location ids (e.g. 1-92416) used by all location commands",
   "method": "GET",
   "urlTemplate": "/api/v0/locations/search",
   "params": [
    {
     "name": "q",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Place name to search for",
     "example": "Bergen"
    },
    {
     "name": "language",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Response language",
     "enum": [
      "nb",
      "nn",
      "en",
      "sme"
     ],
     "default": "nb"
    }
   ],
   "responseType": "json",
   "resultPath": "_embedded.location",
   "defaultFields": [
    "id",
    "name",
    "category.name",
    "subregion.name",
    "region.name",
    "country.name",
    "position.lat",
    "position.lon"
   ],
   "mutates": false,
   "example": {
    "q": "Bergen"
   },
   "source": "E22 E21 GET https://www.yr.no/api/v0/locations/search",
   "verified": true
  },
