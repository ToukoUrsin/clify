{
 "name": "uniprot",
 "startUrl": "https://www.uniprot.org/",
 "origin": "https://www.uniprot.org",
 "createdAt": "2026-10-18T08:22:14.731Z",
 "description": "UniProt, the Universal Protein Resource. This CLI wraps the public rest.uniprot.org JSON API to search and fetch UniProtKB protein entries, sequences, publications, version history, taxonomy, keywords, diseases, UniRef clusters and proteomes, plus AlphaFold structure predictions.",
 "commands": [
  {
   "name": "search-proteins",
   "summary": "Search UniProtKB protein entries with a query; filters such as reviewed or organism go inside the query string",
   "method": "GET",
   "urlTemplate": "https://rest.uniprot.org/uniprotkb/search?format=json",
   "params": [
    {
     "name": "query",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "UniProt query syntax. Free text or field queries joined with AND/OR/NOT, e.g. 'hemoglobin', '(hemoglobin) AND (reviewed:true)', '(hemoglobin) AND (model_organism:9606)', 'gene:HBB AND organism_id:9606",
     "example": "hemoglobin"
    },
    {
     "name": "api_fields",
     "key": "fields",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Comma-separated result fields. list-result-fields --database uniprotkb lists the valid names (sent to the site as \"fields\"; clify's own --fields only shapes the output)",
     "default": "accession,reviewed,id,protein_name,gene_names,organism_name,length"
    },
    {
     "name": "sort",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Sort as '<field> asc|desc'. Sortable fields include accession, id, gene, length, mass, organism_name, protein_name, annotation_score. Example: 'length desc'",
     "example": "length desc"
    },
    {
     "name": "size",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Number of results to return (max 500)",
     "default": 25
    }
   ],
   "headers": {
    "Accept": "application/json"
   },
   "responseType": "json",
   "resultPath": "results",
   "defaultFields": [
    "primaryAccession",
    "uniProtkbId",
    "entryType",
    "proteinDescription.recommendedName.fullName.value",
    "genes",
    "organism.scientificName",
    "organism.taxonId",
    "sequence.length"
   ],
   "mutates": false,
   "example": {
    "query": "(hemoglobin) AND (reviewed:true)"
   },
   "source": "E2",
   "verified": true
  },
  {
   "name": "count-protein-facets",
   "summary": "Get facet counts (reviewed status, model organism, existence level, annotation score, length bins, etc.) for a UniProtKB query without fetching entries",
   "method": "GET",
   "urlTemplate": "https://rest.uniprot.org/uniprotkb/search?size=0&format=json",
   "params": [
    {
     "name": "query",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "UniProt query, e.g. 'hemoglobin' or '*' for everything",
     "example": "hemoglobin"
    },
    {
     "name": "facets",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Comma-separated facet names: reviewed, model_organism, proteins_with, existence, annotation_score, length",
     "default": "reviewed,model_organism,proteins_with,existence,annotation_score,length"
    }
   ],
   "headers": {
    "Accept": "application/json"
   },
   "responseType": "json",
   "resultPath": "facets",
   "defaultFields": [
    "name",
    "label",
    "values"
   ],
   "mutates": false,
   "example": {
    "query": "hemoglobin"
   },
   "source": "E2",
   "verified": true
  },
  {
