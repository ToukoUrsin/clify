  {
   "name": "download-protein",
   "summary": "Download a UniProtKB entry as plain text: a FASTA sequence, the flat file, or GFF features",
   "method": "GET",
   "urlTemplate": "https://rest.uniprot.org/uniprotkb/{accession}.{format}",
   "params": [
    {
     "name": "accession",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "UniProtKB accession",
     "example": "P68871"
    },
    {
     "name": "format",
     "in": "path",
     "required": false,
     "type": "string",
     "description": "Download format: fasta (sequence), txt (UniProt flat file) or gff (features)",
     "enum": [
      "fasta",
      "txt",
      "gff"
     ],
     "default": "fasta"
    }
   ],
   "responseType": "text",
   "mutates": false,
   "example": {
