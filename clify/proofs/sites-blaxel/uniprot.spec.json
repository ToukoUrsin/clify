    {
     "name": "api_fields",
     "key": "fields",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Optional comma-separated fields that limit the returned entry, e.g. 'accession,protein_name,cc_function,sequence' (sent to the site as \"fields\"; clify's own --fields only shapes the output)"
