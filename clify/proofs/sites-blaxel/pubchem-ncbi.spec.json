  {
   "name": "structure-search",
   "summary": "Run an identity, similarity, substructure, superstructure or 3D-similarity search seeded by a compound CID. Returns the hit count and a cache key.",
   "method": "GET",
   "urlTemplate": "/interactive/unified_search/structure_search.cgi?format=json&queryblob=%7B%22query%22%3A%7B%22type%22%3A%22{type}%22%2C%22parameter%22%3A%5B%7B%22name%22%3A%22cid%22%2C%22string%22%3A%22{cid}%22%7D%2C%7B%22name%22%3A%22UseCache%22%2C%22bool%22%3Atrue%7D%5D%7D%7D",
   "params": [
    {
     "name": "cid",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "PubChem Compound ID used as the query structure",
     "example": "2519"
    },
    {
     "name": "type",
     "in": "path",
     "required": false,
     "type": "string",
     "description": "Structure search type",
     "enum": [
      "similarity",
      "substructure",
      "superstructure",
      "identity",
      "similarity_3d"
     ],
     "default": "similarity"
    }
   ],
   "responseType": "json",
   "resultPath": "response",
   "defaultFields": [
    "status",
    "hitcount",
    "cachekey"
   ],
   "mutates": false,
   "example": {
    "cid": "2519",
    "type": "similarity"
   },
   "source": "E3 GET https://pubchem.ncbi.nlm.nih.gov/interactive/unified_search/structure_search.cgi",
   "verified": true
  },
