 "commands": [
  {
   "name": "search-compounds",
   "summary": "Keyword search of PubChem compounds (name, synonym, formula, etc.) with sorting and paging",
   "method": "GET",
   "urlTemplate": "/interactive/sdq/sphinxql.cgi?infmt=json&outfmt=json&query=%7B%22select%22%3A%22*%22%2C%22collection%22%3A%22compound%22%2C%22order%22%3A%5B%22{sort}%22%5D%2C%22start%22%3A{start}%2C%22limit%22%3A{api_limit}%2C%22where%22%3A%7B%22ands%22%3A%5B%7B%22*%22%3A%22{q}%22%7D%5D%7D%7D",
   "params": [
    {
     "name": "q",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Search keyword, e.g. a compound name, synonym or formula. Do not include double quotes.",
     "example": "caffeine"
    },
    {
     "name": "sort",
     "in": "path",
     "required": false,
     "type": "string",
     "description": "Sort order as 'field,dir'. Examples: relevancescore,desc; cid,asc; complexity,desc; mw,asc; mw,desc; annothitcnt,desc",
     "default": "relevancescore,desc"
    },
    {
     "name": "start",
     "in": "path",
     "required": false,
     "type": "number",
     "description": "1-based index of the first row. Page 2 with limit 10 is start=11.",
     "default": 1
    },
    {
     "name": "api_limit",
     "in": "path",
     "required": false,
     "type": "number",
     "description": "Rows per page (sent to the site as \"limit\"; clify's own --limit only shapes the output)",
     "default": 10
    }
   ],
   "responseType": "json",
   "resultPath": "SDQOutputSet.0.rows",
   "defaultFields": [
    "cid",
    "cmpdname",
    "mf",
    "mw",
    "iupacname",
    "inchikey",
    "annothitcnt"
   ],
   "pagination": {
    "type": "offset",
    "param": "start",
    "step": 10
   },
   "mutates": false,
   "example": {
    "q": "caffeine"
   },
   "source": "E2 GET https://pubchem.ncbi.nlm.nih.gov/interactive/sdq/sphinxql.cgi",
   "verified": true
