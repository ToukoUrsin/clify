  {
   "name": "get-weather-alerts",
   "summary": "Get active NWS watches, warnings and advisories, optionally limited to a lat,lng point (e.g. a park location) or a state/area code",
   "method": "GET",
   "urlTemplate": "https://api.weather.gov/alerts?active=1",
   "params": [
    {
     "name": "point",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "lat,lng with at most 4 decimals, e.g. 34.0114,-116.0975. Do not combine with area",
     "example": "34.0114,-116.0975"
    },
    {
     "name": "area",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Two-letter state or marine area code, e.g. CA or NC. Do not combine with point",
     "example": "NC"
    },
    {
     "name": "severity",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Filter by severity",
     "enum": [
      "Extreme",
      "Severe",
      "Moderate",
      "Minor",
      "Unknown"
     ]
    },
    {
     "name": "api_limit",
     "key": "limit",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Maximum number of alerts to return (sent to the site as \"limit\"; clify's own --limit only shapes the output)"
    }
   ],
   "responseType": "json",
   "resultPath": "features",
   "defaultFields": [
    "properties.event",
    "properties.headline",
    "properties.severity",
    "properties.areaDesc",
    "properties.effective",
    "properties.expires",
    "properties.description"
   ],
   "mutates": false,
   "example": {
    "api_limit": "20"
   },
   "source": "E17",
   "verified": true
  },
