 "description": "National Park Service (nps.gov): find parks by state, activity, topic or location; read park details, alerts, parking and conditions; search articles and multimedia; get photo metadata, video captions and NWS weather for parks.",
 "commands": [
  {
   "name": "search-parks",
   "summary": "Find National Park Service units, filtered by state, activity or topic, or sorted by distance from a lat/lng point",
   "method": "GET",
   "urlTemplate": "https://central.nps.gov/units/api/v1/parks/findapark?pagesize=1000&apikey=CfJDEBe7xKJ8v6xZOMkh7AaUGF70dBe3",
   "params": [
    {
     "name": "states",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Two-letter state code(s), comma-separated, e.g. CA or CA,NV (see list-park-filters)",
     "example": "CA"
    },
    {
     "name": "activities",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Activity id(s), comma-separated, e.g. 3 = Arts and Culture (ids from list-park-filters)",
     "example": "3"
    },
    {
     "name": "topics",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Topic id(s), comma-separated (ids from list-park-filters)",
     "example": "125"
    },
    {
     "name": "lat",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Latitude of a search point (use with lng and sort='distance asc')",
     "example": "37.84835"
    },
    {
     "name": "lng",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Longitude of a search point",
     "example": "-119.55696"
    },
    {
     "name": "sort",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Sort order. Use 'distance asc' only when lat/lng are given",
     "enum": [
      "name asc",
      "distance asc"
     ],
     "default": "name asc"
    }
   ],
   "responseType": "json",
   "defaultFields": [
    "parkCode",
    "name",
    "primaryDesignation",
    "stateCode",
    "geometry.coordinates"
   ],
   "mutates": false,
   "example": {
    "states": "CA",
    "topics": "125",
    "activities": "3"
   },
   "source": "E4 GET https://central.nps.gov/units/api/v1/parks/findapark",
   "verified": true
  },
