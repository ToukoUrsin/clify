  {
   "name": "search-multimedia",
   "summary": "Search NPS photos, videos, audio and webcams by keyword, with optional Solr filter (type, park) and sort",
   "method": "GET",
   "urlTemplate": "/solr/?fl=Type,Title,Credit,Duration,Date_Taken,Image_URL,Image_Alt_Text,Sites,Parks,Organizations,Sites_Item,Abstract,PageURL&defType=edismax&fq=-Type:%22Podcast%20Episode%22&fq=-Is_Sensitive_Video:%22true%22&fq=Category:%22Multimedia%22&rows=20&wt=json",
   "params": [
    {
     "name": "q",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Keywords; '*' matches everything",
     "default": "*",
     "example": "grizzly bear"
    },
    {
     "name": "fq",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Extra Solr filter, e.g. Type:\"Video\", Type:\"Photo\", Parks_Item:\"Yellowstone National Park\" (full park name). Combine with AND",
     "example": "Parks_Item:\"Yellowstone National Park\""
    },
    {
     "name": "sort",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Sort order",
     "enum": [
      "Date_Last_Modified desc",
      "score desc",
      "Date_Taken desc"
     ],
     "default": "Date_Last_Modified desc"
    },
    {
     "name": "start",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Result offset (20 per page)",
     "default": 0
    }
   ],
   "responseType": "json",
   "resultPath": "response.docs",
   "defaultFields": [
    "Title",
    "Type",
    "PageURL",
    "Date_Taken",
    "Parks",
    "Credit",
    "Duration",
    "Image_URL"
   ],
   "pagination": {
    "type": "offset",
    "param": "start",
    "step": 20
   },
   "mutates": false,
   "example": {
    "q": "grizzly bear",
    "fq": "Parks_Item:\"Yellowstone National Park\"",
    "sort": "score desc"
   },
   "source": "E39 GET https://www.nps.gov/solr/",
   "verified": true
  },
  {
   "name": "search-articles",
   "summary": "Search NPS articles, people and places pages by keyword (returns /articles/... URLs)",
   "method": "POST",
   "urlTemplate": "/solr/",
   "params": [
    {
     "name": "q",
     "in": "body",
     "required": true,
     "type": "string",
     "description": "Keywords or Solr query, e.g. campfire or \"National Park Week\"",
     "example": "campfire"
    },
    {
     "name": "rows",
     "in": "body",
     "required": false,
     "type": "number",
     "description": "Results per page",
     "default": 10
    },
    {
     "name": "start",
     "in": "body",
     "required": false,
     "type": "number",
     "description": "Result offset",
     "default": 0
    }
   ],
   "bodyTemplate": {
    "defType": "edismax",
    "fq": "Category:\"Articles\" AND (Type:\"Article\" OR Type:\"Person\" OR Type:\"Place\") AND -Allow_Listing_Display:false",
    "q": "{q}",
    "rows": "{rows}",
    "start": "{start}",
    "fl": "PageURL,Title,Type,Image_URL,Image_Alt_Text",
    "sort": "score desc",
    "wt": "json"
   },
   "bodyEncoding": "form",
   "responseType": "json",
   "resultPath": "response.docs",
   "defaultFields": [
    "Title",
    "Type",
    "PageURL",
    "Image_URL"
   ],
   "pagination": {
    "type": "offset",
    "param": "start",
    "step": 10
   },
   "mutates": false,
   "example": {
    "q": "campfire"
   },
   "source": "E42 POST https://www.nps.gov/solr/",
   "verified": true
  },
  {
   "name": "get-article",
