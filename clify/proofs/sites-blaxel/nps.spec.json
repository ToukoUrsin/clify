  {
   "name": "get-weather-point",
   "summary": "Look up the NWS forecast grid (office, gridX, gridY), nearest city, time zone and sunrise/sunset for a lat/lng",
   "method": "GET",
   "urlTemplate": "https://api.weather.gov/points/{lat},{lng}",
   "params": [
    {
     "name": "lat",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Latitude, max 4 decimals (more decimals cause a 301 redirect)",
     "example": "34.0114"
    },
    {
     "name": "lng",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Longitude, max 4 decimals",
     "example": "-116.0975"
    }
   ],
   "responseType": "json",
   "resultPath": "properties",
   "defaultFields": [
    "gridId",
    "gridX",
    "gridY",
    "forecast",
    "relativeLocation.properties.city",
    "relativeLocation.properties.state",
    "timeZone",
    "astronomicalData"
   ],
   "mutates": false,
   "example": {
    "lat": "34.0114",
    "lng": "-116.0975"
   },
   "source": "E20 GET https://api.weather.gov/points/34.0114,-116.0975",
   "verified": true
  },
