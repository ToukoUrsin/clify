  {
   "name": "get-trending",
   "summary": "Trending movies and TV shows today or this week (home page scroller, 20 items)",
   "method": "GET",
   "urlTemplate": "/remote/panel?panel=trending_scroller&group={group}",
   "params": [
    {
     "name": "group",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Time window",
     "enum": [
      "today",
      "this-week"
     ],
     "default": "today",
     "example": "this-week"
    }
   ],
   "headers": {
    "X-Requested-With": "XMLHttpRequest"
   },
   "responseType": "html",
   "extract": {
    "list": "div.comp\\:poster-item",
    "fields": {
     "title": "h2 span || h2",
     "url": "a.font-normal@href || a@href",
     "release_date": "span.release_date"
    }
   },
   "defaultFields": [
    "title",
    "url",
    "release_date"
   ],
   "mutates": false,
   "example": {
    "group": "today"
   },
   "source": "E11 GET https://www.themoviedb.org/remote/panel",
   "verified": true
  },
