{
 "name": "open-meteo",
 "startUrl": "https://open-meteo.com/",
 "origin": "https://open-meteo.com",
 "createdAt": "2026-10-18T08:12:13.743Z",
 "description": "Open-Meteo: free, keyless weather APIs. The CLI provides forecasts, historical reanalysis, archived and previous model runs, ensembles, seasonal and climate projections, marine, air quality, satellite radiation, flood, elevation, geocoding and CSV export.",
 "commands": [
  {
   "name": "search-locations",
   "summary": "Find places by name or postal code and get their coordinates, timezone, country and population. Use this first to turn a city name into latitude/longitude.",
   "method": "GET",
   "urlTemplate": "https://geocoding-api.open-meteo.com/v1/search?format=json",
   "params": [
    {
     "name": "name",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Location name or postal code. You can narrow it with ', <country or admin1>', e.g. 'Paris, Texas'. Two characters must match exactly; three or more are prefix-matched.",
     "example": "London"
    },
    {
     "name": "count",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Maximum number of results (1-100)",
     "default": 10,
     "example": "10"
    },
    {
     "name": "language",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Language for the returned names, as an ISO 639-1 code (en, fr, de, ...)",
     "default": "en",
     "example": "en"
    },
    {
     "name": "countryCode",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Return only results in this ISO 3166-1 alpha-2 country, e.g. US, GB, DE",
     "example": "US"
    }
   ],
   "responseType": "json",
   "resultPath": "results",
   "defaultFields": [
    "id",
    "name",
    "latitude",
    "longitude",
    "country",
    "admin1",
    "timezone",
    "population"
   ],
   "mutates": false,
   "example": {
    "name": "London",
    "count": "10",
    "language": "en"
   },
   "source": "E1 E16 GET https://geocoding-api.open-meteo.com/v1/search",
   "verified": true
  },
  {
   "name": "get-forecast",
   "summary": "Weather forecast for one or more coordinates: current conditions plus hourly and daily variables, up to 16 days ahead and 92 past days, with an optional national model (e.g. DWD ICON).",
   "method": "GET",
   "urlTemplate": "https://api.open-meteo.com/v1/forecast?format=json",
   "params": [
    {
     "name": "latitude",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Latitude in WGS84 decimal degrees. Comma-separate values for several locations, e.g. 52.52,48.85",
     "example": "48.85"
    },
    {
     "name": "longitude",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Longitude in decimal degrees. For several locations, comma-separate in the same order as latitude",
     "example": "2.35"
    },
    {
     "name": "hourly",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Comma-separated hourly variables, e.g. temperature_2m,relative_humidity_2m,precipitation,wind_speed_10m,weather_code,cloud_cover",
     "example": "temperature_2m,precipitation"
    },
    {
     "name": "daily",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Comma-separated daily variables, e.g. temperature_2m_max,temperature_2m_min,precipitation_sum,sunrise,sunset,weather_code. Needs timezone.",
     "example": "temperature_2m_max,temperature_2m_min,sunrise,sunset"
    },
    {
     "name": "current",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Comma-separated current-condition variables, e.g. temperature_2m,wind_speed_10m,weather_code",
     "example": "temperature_2m,wind_speed_10m,weather_code"
    },
    {
     "name": "timezone",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "IANA timezone for timestamps and daily aggregation, e.g. Europe/Paris, or 'auto' for the location's timezone. Defaults to GMT.",
     "example": "Europe/Paris"
    },
    {
     "name": "forecast_days",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Number of forecast days (0-16). Defaults to 7.",
     "example": "3"
    },
    {
     "name": "past_days",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Number of past days to include (0-92)",
     "example": "2"
    },
    {
     "name": "start_date",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Explicit start date (yyyy-mm-dd). Use together with end_date instead of forecast_days/past_days.",
     "example": "2026-10-18"
    },
    {
     "name": "end_date",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Explicit end date (yyyy-mm-dd)",
     "example": "2026-10-20"
    },
    {
     "name": "models",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Weather model(s), comma-separated, e.g. dwd_icon_seamless, ecmwf_ifs025, gfs_seamless, meteofrance_seamless, ukmo_seamless, jma_seamless. Defaults to best_match.",
     "example": "dwd_icon_seamless"
    },
    {
     "name": "temperature_unit",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Temperature unit",
     "enum": [
      "celsius",
      "fahrenheit"
     ]
    },
    {
     "name": "wind_speed_unit",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Wind speed unit",
     "enum": [
      "kmh",
      "ms",
      "mph",
      "kn"
     ]
    },
    {
     "name": "precipitation_unit",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Precipitation unit",
     "enum": [
      "mm",
      "inch"
     ]
    },
    {
     "name": "timeformat",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Timestamp format: ISO8601 local strings, or unix seconds",
     "enum": [
      "iso8601",
      "unixtime"
     ],
     "default": "iso8601"
    }
   ],
   "responseType": "json",
   "mutates": false,
   "example": {
    "latitude": "48.85",
    "longitude": "2.35",
    "hourly": "temperature_2m,precipitation",
    "daily": "temperature_2m_max,temperature_2m_min,sunrise,sunset",
    "current": "temperature_2m,wind_speed_10m,weather_code",
    "timezone": "Europe/Paris",
    "forecast_days": "3"
   },
   "source": "E2 E15 E30 GET https://api.open-meteo.com/v1/forecast",
   "verified": true
  },
