 "description": "Swift Package Index (swiftpackageindex.com) is a search engine and catalogue of Swift packages. This CLI searches packages, lists them by author, keyword or curated collection, and reads package details, README, releases, build compatibility results, build logs, DocC documentation, maintainer score info, recent builds and Swift 6 readiness stats.",
 "commands": [
  {
   "name": "search-packages",
   "summary": "Search Swift packages by keyword. Supports inline filters such as stars:>500, platform:ios,linux, last_activity:>2025-01-01 and product:library inside the query.",
   "method": "GET",
   "urlTemplate": "/search",
   "params": [
    {
     "name": "query",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Search terms, optionally with inline filters, e.g. 'networking stars:>500 platform:ios,linux last_activity:>2025-01-01 product:library'. Filter keys: stars (e.g. stars:>500), platform (ios, macos, lin",
     "example": "networking"
    },
    {
     "name": "page",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Result page number, starting at 1. Each page has 20 packages.",
     "example": "2"
    }
   ],
   "responseType": "html",
   "extract": {
    "list": "ul#package-list > li",
    "fields": {
     "name": "h4",
     "summary": "a > p",
     "identifier": "li.identifier small",
     "activity": "li.activity small",
     "stars": "li.stars small",
     "matchingKeywords": "ul.keywords.matching",
     "url": "a@href"
    }
   },
   "defaultFields": [
    "identifier",
    "name",
    "summary",
    "stars",
    "activity",
    "url"
   ],
   "pagination": {
    "type": "page",
    "param": "page"
   },
   "mutates": false,
   "example": {
    "query": "networking"
   },
   "source": "E2",
   "verified": true
  },
