     "meta": "p.meta.crumbtrail",
     "text": ""
    }
   },
   "defaultFields": [
    "name",
    "url",
    "previousNames",
    "text"
   ],
   "pagination": {
    "type": "page",
    "param": "page"
   },
   "mutates": false,
   "example": {
    "q": "tesco"
   },
   "source": "E1 GET https://find-and-update.company-information.service.gov.uk/search/companies",
   "verified": true
  },
