  {
   "name": "advanced-search-companies",
   "summary": "Advanced company search. Filter by name include/exclude, registered office address, incorporation and dissolution date ranges, status, SIC code and company type. Returns company names and profile URLs",
   "method": "GET",
   "urlTemplate": "/advanced-search/get-results",
   "params": [
    {
     "name": "companyNameIncludes",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Company name must contain this text",
     "example": "bakery"
    },
    {
     "name": "companyNameExcludes",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Exclude company names containing this text"
    },
    {
     "name": "registeredOfficeAddress",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Full or partial registered office address",
     "example": "london"
    },
    {
     "name": "incorporationFromDay",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Incorporated on or after: day (1-31)"
    },
    {
     "name": "incorporationFromMonth",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Incorporated on or after: month (1-12)"
    },
    {
     "name": "incorporationFromYear",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Incorporated on or after: year (YYYY)",
     "example": "2015"
    },
    {
     "name": "incorporationToDay",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Incorporated on or before: day"
    },
    {
     "name": "incorporationToMonth",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Incorporated on or before: month"
    },
    {
     "name": "incorporationToYear",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Incorporated on or before: year"
    },
    {
     "name": "dissolvedFromDay",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Dissolved on or after: day"
    },
    {
     "name": "dissolvedFromMonth",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Dissolved on or after: month"
    },
    {
     "name": "dissolvedFromYear",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Dissolved on or after: year"
    },
    {
     "name": "dissolvedToDay",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Dissolved on or before: day"
    },
    {
     "name": "dissolvedToMonth",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Dissolved on or before: month"
    },
    {
     "name": "dissolvedToYear",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Dissolved on or before: year"
    },
    {
     "name": "status",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Company status",
     "enum": [
      "active",
      "dissolved",
      "open",
      "closed",
      "converted-closed",
      "receivership",
      "administration",
      "liquidation",
      "insolvency-proceedings",
      "voluntary-arrangement"
     ],
     "example": "active"
    },
    {
     "name": "sicCodes",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "SIC nature-of-business code, e.g. 10710 (bread and fresh pastry)",
     "example": "10710"
    },
    {
     "name": "type",
     "in": "query",
