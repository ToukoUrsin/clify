  {
   "name": "get-disqualified-officer",
   "summary": "Get disqualification details for a person or company: date of birth, nationality, disqualification type, start and end dates, case reference, companies involved and reason.",
   "method": "GET",
   "urlTemplate": "/disqualified-officers/{kind}/{officerId}",
   "params": [
    {
     "name": "kind",
     "in": "path",
     "required": false,
     "type": "string",
     "description": "'natural' for a person, 'corporate' for a company. Take it from the search result URL.",
     "enum": [
      "natural",
      "corporate"
     ],
     "default": "natural",
     "example": "natural"
    },
    {
     "name": "officerId",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Disqualified officer id, the last segment of the URL returned by search-disqualified-officers",
     "example": "b0FM3wgkYJ_p3TGirZotCfndF7c"
    }
   ],
   "responseType": "html",
   "extract": {
    "fields": {
     "name": "header.text > h1.heading-xlarge",
     "dateOfBirth": "dl.column-quarter dd.data",
     "disqualificationType": "div.disqualification h3.heading-medium",
     "disqualifications": "div.disqualification",
     "conductWhileActingFor": "dl.text ul.list-bullet",
     "reason": "dl.text dd.data"
    }
   },
   "defaultFields": [
    "name",
    "dateOfBirth",
    "disqualificationType",
    "disqualifications"
   ],
   "mutates": false,
   "example": {
    "kind": "natural",
    "officerId": "b0FM3wgkYJ_p3TGirZotCfndF7c"
   },
   "source": "E10 GET https://find-and-update.company-information.service.gov.uk/disqualified-officers/natural/{id}",
   "verified": true
  },
  {
