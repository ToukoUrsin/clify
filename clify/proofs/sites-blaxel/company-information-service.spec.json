{
 "name": "company-information-service",
 "startUrl": "https://find-and-update.company-information.service.gov.uk/",
 "origin": "https://find-and-update.company-information.service.gov.uk",
 "createdAt": "2026-10-18T08:45:06.804Z",
 "description": "Companies House public register (UK): search companies, officers and disqualified directors, and read company profiles, filing history, officers, PSCs, charges, officer appointments, dissolved and alphabetical company searches, name availability, advanced search with CSV export, and filing document PDFs.",
 "commands": [
  {
   "name": "search-all",
   "summary": "Search companies and officers together by keyword. Results are mixed; the item class is type-company or type-officer.",
   "method": "GET",
   "urlTemplate": "/search",
   "params": [
    {
     "name": "q",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Search keyword: a company name, company number or person name",
     "example": "tesco"
    },
    {
     "name": "page",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Result page number, starting at 1",
     "example": "2"
    }
   ],
   "responseType": "html",
   "extract": {
    "list": "ul#results > li",
    "fields": {
     "kind": "@class",
     "name": "h3 > a",
     "url": "h3 > a@href",
     "previousNames": "p.meta.crumbtrail span",
     "meta": "p.meta.crumbtrail",
     "text": ""
    }
   },
   "defaultFields": [
    "kind",
    "name",
    "url",
    "meta",
    "text"
   ],
   "pagination": {
    "type": "page",
    "param": "page"
   },
   "mutates": false,
   "example": {
    "q": "tesco"
   },
   "source": "E8 GET https://find-and-update.company-information.service.gov.uk/search",
   "verified": true
  },
  {
