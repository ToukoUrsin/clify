  {
   "name": "get-filing-document",
   "summary": "Download a filing document PDF. The server redirects to a signed S3 URL.",
   "method": "GET",
   "urlTemplate": "/company/{companyNumber}/filing-history/{transactionId}/document",
   "params": [
    {
     "name": "companyNumber",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Company number",
     "example": "00445790"
    },
    {
     "name": "transactionId",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Filing transaction id, the path segment after /filing-history/ in a documentUrl from list-filing-history",
     "example": "MzUzNDMwNDQ5M2FkaXF6a2N4"
    },
    {
     "name": "format",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Document format",
     "enum": [
      "pdf"
     ],
     "default": "pdf"
    },
    {
     "name": "download",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "1 to force a download (attachment), 0 to view inline",
     "enum": [
      "0",
      "1"
     ],
     "default": "0"
    }
   ],
   "responseType": "text",
   "mutates": false,
   "example": {
    "companyNumber": "00445790",
    "transactionId": "MzUzNDMwNDQ5M2FkaXF6a2N4"
   },
   "source": "E20 GET https://find-and-update.company-information.service.gov.uk/company/{n}/filing-history/{id}/document",
   "verified": true
  },
