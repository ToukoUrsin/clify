   "summary": "List all police forces (id and name). Use the id in other commands.",
   "method": "GET",
   "urlTemplate": "/api/forces",
   "params": [],
   "responseType": "json",
   "defaultFields": [
    "id",
    "name"
   ],
   "mutates": false,
   "source": "E2 GET https://data.police.uk/api/forces",
   "verified": true
  },
  {
   "name": "get-force",
