  {
   "name": "street-crimes",
   "summary": "Street-level crimes for one month, either within a 1-mile radius of a lat/lng point or inside a custom polygon. Can be limited to one category.",
   "method": "GET",
   "urlTemplate": "/api/crimes-street/{category}",
   "params": [
    {
     "name": "category",
     "in": "path",
     "required": false,
     "type": "string",
     "description": "Crime category slug (see list-crime-categories)",
     "enum": [
      "all-crime",
      "anti-social-behaviour",
      "bicycle-theft",
      "burglary",
      "criminal-damage-arson",
      "drugs",
      "other-theft",
      "possession-of-weapons",
      "public-order",
      "robbery",
      "shoplifting",
      "theft-from-the-person",
      "vehicle-crime",
      "violent-crime",
      "other-crime"
     ],
     "default": "all-crime",
     "example": "all-crime"
    },
    {
     "name": "lat",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Latitude of the centre point. Use with lng; do not combine with poly.",
     "example": "52.629729"
    },
    {
     "name": "lng",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Longitude of the centre point. Use with lat.",
     "example": "-1.131592"
    },
    {
     "name": "poly",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Polygon as lat,lng pairs separated by colons, e.g. 52.268,0.543:52.794,0.238:52.130,0.478. Use instead of lat/lng.",
     "example": "52.268,0.543:52.794,0.238:52.130,0.478"
    },
    {
     "name": "date",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Month in YYYY-MM format. Omit for the latest month.",
     "example": "2024-01"
    }
   ],
   "responseType": "json",
   "defaultFields": [
    "persistent_id",
    "category",
    "month",
    "location.street.name",
    "location.street.id",
    "location.latitude",
    "location.longitude",
    "outcome_status.category"
   ],
   "mutates": false,
   "example": {
    "category": "all-crime",
    "lat": "52.629729",
    "lng": "-1.131592",
    "date": "2024-01"
   },
   "source": "E1 E7 GET https://data.police.uk/api/crimes-street/all-crime",
   "verified": true
  },
