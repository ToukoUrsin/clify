 "blockers": [],
 "notes": [
  "All commands are public reads and need no login. They use the site's internal /api/internal/* endpoints, which may change without notice.",
  "Components are identified by namespace (Maven groupId), name (artifactId) and version. Search results give the latest version in latestVersionInfo.version; use list-versions for the others.",
  "Pages are 0-based. The response includes pageCount and totalResultCount.",
  "Timestamps (publishedEpochMillis, timestampUnixWithMS) are Unix epoch milliseconds.",
  "The UI's 'All' dependency type sends no dependencyRef filter. These commands support only DIRECT or INDIRECT.",
  "Not exposed because the request bodies were not captured: the category filter key (inferred as 'category:<name>'), sort-by-published-date, and the dependent-on purl / contributor-email search filters.",
  "Binary artifacts (jars, poms) can be downloaded directly from https://repo1.maven.org/maven2/{groupId as path}/{artifactId}/{version}/.",
  "The Central Publisher API (/api/v1/publisher/*, documented at /api-doc) needs a bearer token and is not covered."
 ],
