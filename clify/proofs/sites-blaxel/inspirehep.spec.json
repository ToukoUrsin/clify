  {
   "name": "get-literature-facets",
   "summary": "Get facet counts and aggregations for a literature query: doc types, subjects, authors, collaborations, citations-by-year, citation summary",
   "method": "GET",
   "urlTemplate": "/api/literature/facets",
   "params": [
    {
     "name": "q",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "INSPIRE search query, e.g. 'dark matter' or 'recid:648746'",
     "example": "recid:648746"
    },
    {
     "name": "facet_name",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Special facet set to compute. Omit for the standard search facets.",
     "enum": [
      "citations-by-year",
      "citation-summary",
      "hep-author-publication"
     ],
     "example": "citations-by-year"
    },
    {
     "name": "search_type",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Set to hep-author-publication together with author to get facets for one author's papers",
     "enum": [
      "hep-author-publication"
     ]
    },
    {
     "name": "author",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Author facet key 'RECID_Full Name' (facet_author_name from get-author)",
     "example": "1019524_Gianfranco Bertone"
    },
    {
     "name": "doc_type",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Document type filter, e.g. review, article, published"
    }
   ],
   "responseType": "json",
   "resultPath": "aggregations",
   "mutates": false,
   "example": {
    "q": "recid:648746",
    "facet_name": "citations-by-year"
   },
   "source": "E1 GET https://inspirehep.net/api/literature/facets",
   "verified": true
  },
