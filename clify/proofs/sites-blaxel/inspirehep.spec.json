{
 "name": "inspirehep",
 "startUrl": "https://inspirehep.net/",
 "origin": "https://inspirehep.net",
 "createdAt": "2026-10-18T09:00:21.317Z",
 "description": "INSPIRE-HEP is the high-energy physics literature database. This CLI searches and fetches papers, citations, references, BibTeX/LaTeX exports, authors, jobs, conferences, seminars, institutions and experiments through INSPIRE's public JSON API.",
 "commands": [
  {
   "name": "search-literature",
   "summary": "Search HEP papers with INSPIRE query syntax, with optional filters for document type, date range, author count and subject, plus sorting and paging",
   "method": "GET",
   "urlTemplate": "/api/literature",
   "params": [
    {
     "name": "q",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "INSPIRE search query: free text ('dark matter'), 'a G.Bertone.1' (author identifier), 't higgs' (title), 'refersto:recid:648746' (papers citing a record), 'affid 902725' (institution), 'accelerator_ex",
     "example": "dark matter"
    },
    {
     "name": "sort",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Sort order",
     "enum": [
      "mostrecent",
      "mostcited"
     ],
     "default": "mostrecent"
    },
    {
     "name": "doc_type",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Document type facet value, e.g. article, published, review, conference paper, thesis, book, proceedings, lectures, note, report",
     "example": "review"
    },
    {
     "name": "earliest_date",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Year range 'YYYY--YYYY'",
     "example": "2020--2026"
    },
    {
     "name": "author_count",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Number-of-authors facet value, e.g. 'Single author' or '10 authors or less'",
     "example": "10 authors or less"
    },
    {
     "name": "subject",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Subject facet value, e.g. Astrophysics, Phenomenology-HEP, Theory-HEP, Experiment-HEP",
     "example": "Astrophysics"
    },
    {
     "name": "size",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Results per page",
     "default": 25
    },
    {
     "name": "page",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Page number, starting at 1",
     "default": 1
    }
   ],
   "headers": {
    "Accept": "application/vnd+inspire.record.ui+json"
   },
   "responseType": "json",
   "resultPath": "hits.hits",
   "defaultFields": [
    "id",
    "metadata.titles.0.title",
    "metadata.authors.0.full_name",
    "metadata.number_of_authors",
    "metadata.date",
    "metadata.citation_count",
    "metadata.arxiv_eprints.0.value",
    "metadata.dois.0.value"
   ],
   "pagination": {
    "type": "page",
    "param": "page"
   },
   "mutates": false,
   "example": {
    "q": "dark matter",
    "sort": "mostcited",
    "doc_type": "review"
   },
   "source": "E2 E25 GET https://inspirehep.net/api/literature",
   "verified": true
  },
