 "description": "opam.ocaml.org is the official OCaml package repository site. This CLI lists all opam packages (by name or by last update), and fetches package and version details, dependencies and reverse dependencies, from the server-rendered HTML.",
 "commands": [
  {
   "name": "list-packages",
   "summary": "List every opam package alphabetically by name, with latest version and description. The full list comes back in one response; filter it yourself to search.",
   "method": "GET",
   "urlTemplate": "/packages/",
   "params": [],
   "responseType": "html",
   "extract": {
    "list": "tr[title]",
    "fields": {
     "name": "td > a",
     "url": "td > a@href",
     "latest_version": "td + td",
     "description": "td + td + td",
     "published": "@title"
    }
   },
   "defaultFields": [
    "name",
    "latest_version",
    "description",
    "published",
    "url"
   ],
   "mutates": false,
   "source": "E6 GET https://opam.ocaml.org/packages/",
   "verified": true
