{
  "name": "kalshi",
  "startUrl": "https://kalshi.com/",
  "origin": "https://kalshi.com",
  "createdAt": "2026-10-21T07:19:19.735Z",
  "description": "Kalshi prediction-market exchange: search public markets and read prices, volume, order books, trades, price history and close dates from Kalshi's public v1 API (no login needed).",
  "commands": [
    {
      "name": "search-markets",
      "summary": "Search or browse prediction markets (series/events with their markets, prices and volume) by keyword, category, status and frequency, sorted by relevance, trending, volume, newest or closing soon.",
      "method": "GET",
      "urlTemplate": "https://api.elections.kalshi.com/v1/search/series?with_milestones=true",
      "params": [
        {
          "name": "query",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Keyword search text, e.g. bitcoin, fed, senate. Omit to browse everything.",
          "example": "bitcoin"
        },
        {
          "name": "order_by",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Sort order: querymatch (relevance, use with query), trending, volume, event-volume, newest-event, price-delta (top movers), closing (closing soonest).",
          "enum": [
            "querymatch",
            "trending",
            "volume",
            "event-volume",
            "newest-event",
            "price-delta",
            "closing"
          ],
          "default": "querymatch"
        },
        {
          "name": "status",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Market status filter.",
          "enum": [
            "open",
            "unopened",
            "closed"
          ]
        },
        {
          "name": "frequency",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Comma-separated series frequencies: one_off, one_time, daily, weekly, monthly, quarterly, annual, custom.",
          "example": "daily"
        },
        {
          "name": "category",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Category filter, e.g. Economics, Elections, Crypto, Sports, Politics.",
          "example": "Economics"
        },
        {
          "name": "excluded_categories",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Comma-separated categories to exclude, e.g. Sports."
        },
        {
          "name": "page_size",
          "in": "query",
          "required": false,
          "type": "number",
          "description": "Results per page (max 100).",
          "default": 24
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Pagination cursor from the previous response's next_cursor."
        }
      ],
      "responseType": "json",
      "resultPath": "current_page",
      "defaultFields": [
        "series_ticker",
        "event_ticker",
        "event_title",
        "event_subtitle",
        "category",
        "total_volume",
        "total_series_volume",
        "markets"
      ],
      "pagination": {
        "type": "cursor",
        "param": "cursor",
        "nextPath": "next_cursor"
      },
      "mutates": false,
      "example": {
        "query": "bitcoin",
        "order_by": "querymatch"
      },
      "source": "E15 GET https://api.elections.kalshi.com/v1/search/series",
      "sample": "{\"series_ticker\":\"KXBTC15M\",\"event_ticker\":\"KXBTC15M-26OCT210330\",\"event_title\":\"BTC 15 min · $82,730.04 target\",\"event_subtitle\":\"Oct 21 - 3:15AM EDT to 3:30AM EDT\",\"category\":\"Crypto\",\"total_volume\":438294,\"total_series_volume\":301715816,\"markets\":[{\"ticker\":\"KXBTC15M-26OCT210330-30\",\"yes_subtitle\":\"Target Price: $82,730.04\",\"no_subtitle\":\"\",\"yes_bid\":27,\"",
      "resultFields": [
        "type",
        "series_ticker",
        "series_title",
        "event_ticker",
        "event_subtitle",
        "event_title",
        "category",
        "product_metadata",
        "product_metadata_derived",
        "total_series_volume",
        "total_volume",
        "total_market_count",
        "active_market_count",
        "markets",
        "is_trending",
        "is_new",
        "is_closing",
        "is_price_delta",
        "search_score",
        "fee_type",
        "fee_multiplier",
        "tags",
        "milestone_id"
      ],
      "verified": true
    },
    {
