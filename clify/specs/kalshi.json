    {
      "name": "get-event-forecast-history",
      "summary": "Chart history of an event's forecast (implied probability or implied value) over a time range at a chosen candle interval.",
      "method": "GET",
      "urlTemplate": "https://api.elections.kalshi.com/v1/series/{seriesTicker}/events/{eventTicker}/forecast_history",
      "params": [
        {
          "name": "seriesTicker",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "Series ticker, e.g. KXBTCD.",
          "example": "KXBTCD"
        },
        {
          "name": "eventTicker",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "Event ticker, e.g. KXBTCD-26OCT2117.",
          "example": "KXBTCD-26OCT2117"
        },
        {
          "name": "start_ts",
          "in": "query",
          "required": true,
          "type": "number",
          "description": "Range start, Unix seconds.",
          "example": "1792530000"
        },
        {
          "name": "end_ts",
          "in": "query",
          "required": true,
          "type": "number",
          "description": "Range end, Unix seconds.",
          "example": "1792569600"
        },
        {
          "name": "period_interval",
          "in": "query",
          "required": false,
          "type": "number",
          "description": "Candle length in minutes: 1, 60 or 1440 (daily).",
          "enum": [
            "1",
            "60",
            "1440"
          ],
          "default": 60
        }
      ],
      "responseType": "json",
      "resultPath": "forecast_history",
      "defaultFields": [
        "market_ticker",
        "numerical_forecast",
        "formatted_forecast",
        "end_period_ts"
      ],
      "mutates": false,
      "example": {
        "seriesTicker": "KXBTCD",
        "eventTicker": "KXBTCD-26OCT2117",
        "start_ts": "1792530000",
        "end_ts": "1792569600",
        "period_interval": "1"
      },
