 "description": "Finnish National Library's Digi service (digitized newspapers, journals, books, maps, music and more). The CLI searches full text and metadata, reads issue (binding) details and page OCR text, browses serial titles by year, searches user-made clippings, lists collections, and harvests OAI-PMH metadata.",
 "commands": [
  {
   "name": "search-materials",
   "summary": "Full-text and metadata search over digitized materials. Returns matching pages (bindings) with OCR highlights.",
   "method": "POST",
   "urlTemplate": "/rest/binding-search/search/binding",
   "params": [
    {
     "name": "query",
     "in": "body",
     "required": true,
     "type": "string",
     "description": "Search terms. Supports Digi query syntax (quotes, AND/OR, wildcards).",
     "example": "sibelius"
    },
    {
     "name": "format",
     "in": "body",
     "required": false,
     "type": "string",
     "description": "Material type to search. Sent as a single-element formats array. An empty value can cause a server error, so it defaults to NEWSPAPER.",
     "enum": [
      "NEWSPAPER",
      "JOURNAL",
      "PRINTING",
      "BOOK",
      "MANUSCRIPT",
      "MAP",
      "MUSIC_NOTATION",
      "PICTURE",
      "CARD_INDEX",
      "ARK_KIRJE",
      "ARK_KASIKIRJOITUS"
     ],
     "default": "NEWSPAPER",
     "example": "NEWSPAPER"
    },
    {
     "name": "orderBy",
     "in": "body",
     "required": false,
     "type": "string",
     "description": "Sort order. DATE is oldest first and DATE_DESC is newest first.",
     "enum": [
      "RELEVANCE",
      "DATE",
      "DATE_DESC"
     ],
     "default": "RELEVANCE"
    },
    {
     "name": "startDate",
     "in": "body",
     "required": false,
     "type": "string",
     "description": "Earliest publication date, ISO format, e.g. 1900-01-01"
    },
    {
     "name": "endDate",
     "in": "body",
     "required": false,
     "type": "string",
     "description": "Latest publication date, ISO format, e.g. 1939-12-31"
    },
    {
     "name": "fuzzy",
     "in": "body",
     "required": false,
     "type": "boolean",
     "description": "Fuzzy matching, which tolerates OCR errors",
     "default": false
    },
    {
     "name": "requireAllKeywords",
     "in": "body",
     "required": false,
     "type": "boolean",
     "description": "true means all terms must match (AND); false means any term (OR)",
     "default": true
    },
    {
     "name": "queryTargetsOcrText",
     "in": "body",
     "required": false,
     "type": "boolean",
     "description": "Search the OCR full text",
     "default": true
    },
    {
     "name": "queryTargetsMetadata",
     "in": "body",
     "required": false,
     "type": "boolean",
     "description": "Also search metadata such as titles and authors",
     "default": false
    },
    {
     "name": "offset",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Result offset",
     "default": 0
    },
    {
     "name": "count",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Results per page",
     "default": 20
    }
   ],
   "bodyTemplate": {
    "archiveCollections": [],
    "authors": [],
    "collections": [],
    "districts": [],
    "endDate": "{endDate}",
    "exactCollectionMaterialType": false,
    "formats": [
     "{format}"
    ],
    "fuzzy": "{fuzzy}",
    "hasIllustrations": false,
    "importStartDate": null,
    "importTime": "ANY",
    "includeUnauthorizedResults": false,
    "languages": [],
    "orderBy": "{orderBy}",
    "pages": "",
    "publicationPlaces": [],
    "publications": [],
    "publishers": [],
    "query": "{query}",
    "queryTargetsMetadata": "{queryTargetsMetadata}",
    "queryTargetsOcrText": "{queryTargetsOcrText}",
    "requireAllKeywords": "{requireAllKeywords}",
    "searchForBindings": false,
    "showLastPage": false,
    "startDate": "{startDate}",
    "tags": []
   },
   "bodyEncoding": "json",
   "responseType": "json",
   "resultPath": "rows",
   "defaultFields": [
    "bindingId",
    "bindingTitle",
    "date",
    "generalType",
    "pageNumber",
    "publicationId",
    "url",
    "textHighlights.text"
   ],
   "pagination": {
    "type": "offset",
    "param": "offset",
    "step": 20
   },
   "mutates": false,
   "example": {
    "query": "sibelius",
    "format": "NEWSPAPER"
   },
   "source": "E4",
   "verified": true
  },
