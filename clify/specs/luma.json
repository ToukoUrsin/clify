{
  "name": "luma",
  "startUrl": "https://lu.ma/",
  "origin": "https://lu.ma",
  "createdAt": "2026-10-21T07:02:54.613Z",
  "description": "Luma (lu.ma / luma.com) event discovery: search public events by city, category or keyword, browse community calendars, and get event details, dates, venues and URLs through Luma's JSON API.",
  "commands": [
    {
      "name": "search-events",
      "summary": "List or keyword-search upcoming public events in a Luma city (default San Francisco) or a category such as ai/tech, with dates, area and event URL slug",
      "method": "GET",
      "urlTemplate": "https://api.luma.com/discover/get-paginated-events",
      "params": [
        {
          "name": "placeId",
          "key": "discover_place_api_id",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Discover place id (city). San Francisco is discplace-BDj7GNbGlsF7Cka; other ids come from list-places. Omit when searching a category via --slug.",
          "example": "discplace-BDj7GNbGlsF7Cka"
        },
        {
          "name": "query",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Keyword to search event names, e.g. AI, hackathon, agents",
          "example": "AI"
        },
        {
          "name": "slug",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Category slug (from list-categories), e.g. ai, tech. Use with --latitude/--longitude to center results.",
          "example": "ai"
        },
        {
          "name": "categoryId",
          "key": "discover_category_api_id",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Category id, e.g. cat-ai (alternative to --slug)",
          "example": "cat-ai"
        },
        {
          "name": "latitude",
          "in": "query",
          "required": false,
          "type": "number",
          "description": "Latitude to center category results, e.g. 37.7749 for San Francisco"
        },
        {
          "name": "longitude",
          "in": "query",
          "required": false,
          "type": "number",
          "description": "Longitude to center category results, e.g. -122.4194 for San Francisco"
        },
        {
          "name": "api_limit",
          "key": "pagination_limit",
          "in": "query",
          "required": false,
          "type": "number",
          "description": "Results per page (sent to the site as \"limit\"; clify's own --limit only shapes the output)",
          "default": 25
        },
        {
          "name": "cursor",
          "key": "pagination_cursor",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Pagination cursor from the previous page's next_cursor"
        }
      ],
      "headers": {
        "x-luma-client-type": "luma-web"
      },
      "responseType": "json",
      "resultPath": "entries",
      "defaultFields": [
        "event.api_id",
        "event.name",
        "event.start_at",
        "event.end_at",
        "event.url",
        "event.geo_address_info.city_state",
        "event.geo_address_info.sublocality",
        "calendar.name"
      ],
      "mutates": false,
      "example": {
        "placeId": "discplace-BDj7GNbGlsF7Cka",
        "query": "AI"
      },
      "source": "E2 GET https://api.luma.com/discover/get-paginated-events",
      "sample": "{\"event.api_id\":\"evt-zK5H9iq3UujkOHB\",\"event.name\":\"Durable AI (October Edition)\",\"event.start_at\":\"2026-10-22T00:30:00.000Z\",\"event.end_at\":\"2026-10-22T03:00:00.000Z\",\"event.url\":\"durable-ai-october\",\"event.geo_address_info.city_state\":\"San Francisco, CA\",\"event.geo_address_info.sublocality\":\"Financial District\",\"calendar.name\":\"Temporal Community\"}",
      "resultFields": [
        "api_id",
