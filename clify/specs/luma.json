          "key": "calendar_api_id",
          "in": "query",
          "required": true,
          "type": "string",
          "description": "Calendar id (cal-...). Get it from resolve-url with the calendar's URL slug, or from list-place-calendars",
          "example": "cal-S7gDcd9Akzu62RD"
        },
        {
          "name": "period",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Upcoming or past events",
          "enum": [
            "future",
            "past"
          ],
          "default": "future",
          "example": "past"
