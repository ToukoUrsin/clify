    {
      "name": "list-calendar-events",
      "summary": "List upcoming or past events of a community calendar (e.g. an SF AI meetup group), optionally filtered by tag or keyword",
      "method": "GET",
      "urlTemplate": "https://api.luma.com/calendar/get-items",
