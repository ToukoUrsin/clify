  {
   "name": "list-security-advisories",
   "summary": "List known security advisories (PKSA id, CVE, affected versions, severity) for a package via the official API.",
   "method": "GET",
   "urlTemplate": "/api/security-advisories/",
   "params": [
    {
     "name": "packages",
     "key": "packages[]",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Full package name vendor/package",
     "example": "monolog/monolog"
    },
    {
     "name": "updatedSince",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Only advisories updated after this Unix timestamp"
    }
   ],
   "responseType": "json",
   "resultPath": "advisories",
   "mutates": false,
   "example": {
    "packages": "monolog/monolog"
   },
   "source": "E11 E19 GET https://packagist.org/api/security-advisories/",
   "verified": true
  },
  {
   "name": "get-security-advisory",
   "summary": "Get one security advisory by its PKSA id: severity, title, CVE/GHSA ids, affected package and versions, and reporting sources.",
   "method": "GET",
   "urlTemplate": "/security-advisories/{advisory_id}",
   "params": [
    {
     "name": "advisory_id",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Packagist advisory id, e.g. PKSA-dw7n-x7f5-zf63",
     "example": "PKSA-dw7n-x7f5-zf63"
    }
   ],
   "responseType": "html",
   "extract": {
    "fields": {
     "heading": "div.package-item h4",
     "title": "div.package-item h4 a",
     "link": "div.package-item h4 a@href",
     "ids": "div.package-item div.col-md-8 p",
     "package": "div.package-item a[href^='/packages/']",
     "details": "div.package-item div.col-md-8",
     "reported_by": "div.package-item div.col-md-4 p"
    }
   },
   "defaultFields": [
    "heading",
    "title",
    "ids",
    "package",
    "details",
    "reported_by"
   ],
   "mutates": false,
   "example": {
    "advisory_id": "PKSA-dw7n-x7f5-zf63"
   },
   "source": "E20 GET https://packagist.org/security-advisories/PKSA-dw7n-x7f5-zf63",
   "verified": true
  },
