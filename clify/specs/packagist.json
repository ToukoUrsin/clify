{
 "name": "packagist",
 "startUrl": "https://packagist.org/",
 "origin": "https://packagist.org",
 "createdAt": "2026-10-18T07:07:10.812Z",
 "description": "Packagist.org is the main PHP/Composer package repository. This CLI searches packages, faceted by tags and type, and reads package metadata, install and PHP-version statistics, dependents, suggesters, security advisories, vendor package lists, popular and new packages, PHP extensions and global stats.",
 "commands": [
  {
   "name": "search-packages",
   "summary": "Search Packagist packages by keyword, optionally filtered by package type and tags. Uses the official search.json API.",
   "method": "GET",
   "urlTemplate": "/search.json",
   "params": [
    {
     "name": "q",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Search keywords, e.g. 'logger'",
     "example": "logger"
    },
    {
     "name": "type",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Package type filter, e.g. library, project, symfony-bundle, composer-plugin, php-ext, wordpress-plugin, magento2-module",
     "example": "library"
    },
    {
     "name": "tags",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Tag/keyword filter, e.g. 'psr-3' or 'logging'"
    },
    {
     "name": "per_page",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Results per page (max 100)",
     "default": 15,
     "example": "5"
    },
    {
     "name": "page",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "1-based page number",
     "default": 1
    }
   ],
   "responseType": "json",
   "resultPath": "results",
   "defaultFields": [
    "name",
    "description",
    "url",
    "repository",
    "downloads",
    "favers"
   ],
   "pagination": {
    "type": "page",
    "param": "page"
   },
   "mutates": false,
   "example": {
    "q": "logger",
    "type": "library",
    "per_page": "5"
   },
   "source": "E9 GET https://packagist.org/search.json",
   "verified": true
  },
  {
   "name": "search-packages-faceted",
   "summary": "Search packages through the site's Algolia index. Returns hits plus facet counts per tag and type. Supports Algolia filter expressions; page is 0-based.",
   "method": "POST",
   "urlTemplate": "https://m58222sh95-dsn.algolia.net/1/indexes/*/queries?x-algolia-agent=Algolia%20for%20JavaScript%20(4.26.0)%3B%20Browser%20(lite)%3B%20instantsearch.js%20(4.92.0)%3B%20JS%20Helper%20(3.28.0)&x-algolia-api-key=0cdb98d788b15a422a65e7f2fcecff5b&x-algolia-application-id=M58222SH95",
   "params": [
    {
     "name": "query",
     "in": "body",
     "required": true,
     "type": "string",
     "description": "Search keywords (URL-encode spaces as %20)",
     "example": "logger"
    },
    {
     "name": "filters",
     "in": "body",
     "required": false,
     "type": "string",
     "description": "Algolia filter expression on facets 'type' and 'tags'. Use %20 for spaces. Examples: 'type:library', 'tags:logging', 'type:library%20AND%20tags:logging'. Empty means no filter.",
     "example": "type:library"
    },
    {
     "name": "page",
     "in": "body",
     "required": false,
     "type": "number",
     "description": "0-based page number",
     "default": 0
    },
    {
     "name": "hits_per_page",
     "in": "body",
     "required": false,
     "type": "number",
     "description": "Hits per page",
     "default": 20
    }
   ],
   "bodyTemplate": {
    "requests": [
     {
      "indexName": "packagist",
      "params": "query={query}&page={page}&hitsPerPage={hits_per_page}&filters={filters}&facets=%5B%22tags%22%2C%22type%22%5D&maxValuesPerFacet=20&attributesToRetrieve=%5B%22name%22%2C%22description%22%2C%22type%22%2C%22repository%22%2C%22tags%22%2C%22meta%22%2C%22abandoned%22%2C%22replacementPackage%22%5D&attributesToHighlight=%5B%5D"
     }
    ]
   },
   "bodyEncoding": "json",
   "headers": {
    "content-type": "application/x-www-form-urlencoded"
   },
   "responseType": "json",
   "resultPath": "results.0",
   "defaultFields": [
    "nbHits",
    "page",
    "nbPages",
    "hits",
    "facets"
   ],
   "pagination": {
    "type": "page",
    "param": "page"
   },
   "mutates": false,
   "example": {
    "query": "logger",
    "filters": "type:library"
   },
   "source": "E1 POST https://m58222sh95-dsn.algolia.net/{n}/indexes/*/queries",
   "verified": true
  },
  {
   "name": "search-facet-values",
   "summary": "Search the values of a search facet (tags or type) by prefix, with counts within a keyword query. Useful for finding valid tag names to filter on.",
   "method": "POST",
   "urlTemplate": "https://m58222sh95-dsn.algolia.net/1/indexes/packagist/facets/{facet}/query?x-algolia-agent=Algolia%20for%20JavaScript%20(4.26.0)%3B%20Browser%20(lite)%3B%20instantsearch.js%20(4.92.0)%3B%20JS%20Helper%20(3.28.0)&x-algolia-api-key=0cdb98d788b15a422a65e7f2fcecff5b&x-algolia-application-id=M58222SH95",
   "params": [
    {
     "name": "facet",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Facet to search",
     "enum": [
      "tags",
      "type"
     ],
     "example": "tags"
    },
    {
     "name": "facet_query",
     "key": "facetQuery",
     "in": "body",
     "required": true,
     "type": "string",
     "description": "Prefix of the facet value, e.g. 'sym'",
     "example": "sym"
    },
    {
     "name": "query",
     "in": "body",
     "required": false,
     "type": "string",
     "description": "Package keyword query that restricts which packages are counted",
     "example": "logger"
    }
   ],
   "bodyTemplate": {
    "facetQuery": "{facet_query}",
    "query": "{query}",
    "maxFacetHits": 15
   },
   "bodyEncoding": "json",
   "headers": {
    "content-type": "application/x-www-form-urlencoded"
   },
   "responseType": "json",
   "resultPath": "facetHits",
   "defaultFields": [
    "value",
    "count"
   ],
   "mutates": false,
   "example": {
    "facet": "tags",
    "facet_query": "sym",
    "query": "logger"
   },
   "source": "E3 POST https://m58222sh95-dsn.algolia.net/{n}/indexes/packagist/facets/tags/query",
   "verified": true
  },
  {
   "name": "get-package",
   "summary": "Get full package metadata as JSON: description, maintainers, repository, download totals, favers, and all versions with their requirements.",
   "method": "GET",
   "urlTemplate": "/packages/{vendor}/{package}.json",
   "params": [
    {
     "name": "vendor",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Vendor name, the part before the slash",
     "example": "monolog"
    },
    {
     "name": "package",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Package name, the part after the slash",
     "example": "monolog"
    }
   ],
   "responseType": "json",
   "resultPath": "package",
   "defaultFields": [
    "name",
    "description",
    "type",
    "repository",
    "downloads",
    "favers",
    "github_stars",
    "time"
   ],
   "mutates": false,
   "example": {
    "vendor": "monolog",
    "package": "monolog"
   },
   "source": "E10 GET https://packagist.org/packages/monolog/monolog.json",
   "verified": true
  },
  {
   "name": "get-package-install-stats",
   "summary": "Get a time series of daily installs for a package, averaged daily, weekly or monthly, starting from a date.",
   "method": "GET",
   "urlTemplate": "/packages/{vendor}/{package}/stats/all.json",
   "params": [
    {
     "name": "vendor",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Vendor name",
     "example": "monolog"
    },
    {
     "name": "package",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Package name",
     "example": "monolog"
    },
    {
     "name": "average",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Aggregation granularity",
     "enum": [
      "daily",
      "weekly",
      "monthly"
     ],
     "example": "weekly"
    },
    {
     "name": "from",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Start date, ISO format YYYY-MM-DD",
     "example": "2025-10-18"
    }
   ],
   "responseType": "json",
   "defaultFields": [
    "labels",
    "values",
    "average"
   ],
   "mutates": false,
   "example": {
    "vendor": "monolog",
    "package": "monolog",
    "average": "weekly",
    "from": "2025-10-18"
   },
   "source": "E2 E7 GET https://packagist.org/packages/monolog/monolog/stats/all.json",
   "verified": true
  },
