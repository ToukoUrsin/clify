  {
   "name": "list-dependents",
   "summary": "List packages that depend on a given package. Can sort by downloads and filter by require or require-dev.",
   "method": "GET",
   "urlTemplate": "/packages/{vendor}/{package}/dependents",
   "params": [
    {
     "name": "vendor",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Vendor name",
     "example": "monolog"
    },
    {
     "name": "package",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Package name",
     "example": "monolog"
    },
    {
     "name": "order_by",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Sort order",
     "enum": [
      "downloads",
      "none"
     ],
     "default": "downloads",
     "example": "downloads"
    },
    {
     "name": "requires",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Which dependency kind to include",
     "enum": [
      "all",
      "require",
      "require-dev"
     ],
     "default": "all"
    },
    {
     "name": "page",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "1-based page number (15 per page)",
     "default": 1
    }
   ],
   "responseType": "html",
   "extract": {
    "list": "ul.packages > li.row",
    "fields": {
     "name": "h4 a",
     "url": "h4 a@href",
     "description": "h4 + p",
     "requirement": "p.meta",
     "language": "p.language",
     "downloads": "span.metadata-block",
     "stars": "span.metadata-block + span.metadata-block"
    }
   },
   "defaultFields": [
    "name",
    "url",
    "description",
    "requirement",
    "downloads",
    "stars"
   ],
   "pagination": {
    "type": "page",
    "param": "page"
   },
   "mutates": false,
   "example": {
    "vendor": "monolog",
    "package": "monolog",
    "order_by": "downloads"
   },
   "source": "E14 GET https://packagist.org/packages/monolog/monolog/dependents",
   "verified": true
  },
