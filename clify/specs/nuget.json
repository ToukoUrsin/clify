 "description": "nuget.org, the public .NET package gallery. This CLI searches packages, reads package and version metadata, licenses, owner profiles, and download statistics, and lists NuGet client tool downloads, all without logging in.",
 "commands": [
  {
   "name": "search-packages",
   "summary": "Search the NuGet gallery by keyword or tag (q=Tags:\"bson\"), with sort, framework, package-type and prerelease filters, 20 results per page",
   "method": "GET",
   "urlTemplate": "/packages",
   "params": [
    {
     "name": "q",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Search text. Supports field syntax such as Tags:\"bson\", id:Newtonsoft, owner:jamesnk",
     "example": "json"
    },
    {
     "name": "sortby",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Sort order. 'relevance' is the default ranking",
     "enum": [
      "relevance",
      "totalDownloads-desc",
      "created-desc"
     ]
    },
    {
     "name": "frameworks",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Comma-separated framework generations to filter by, e.g. net, netcoreapp, netstandard, netframework",
     "example": "netstandard"
    },
    {
     "name": "tfms",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Comma-separated specific target framework monikers, e.g. net8.0,netstandard2.0"
    },
    {
     "name": "frameworkFilterMode",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Whether packages must match ALL or ANY of the selected frameworks",
     "enum": [
      "all",
      "any"
     ]
    },
    {
     "name": "includeComputedFrameworks",
     "in": "query",
     "required": false,
     "type": "boolean",
     "description": "Also match frameworks that are computed as compatible, not only frameworks targeted explicitly",
     "default": true
    },
    {
     "name": "packagetype",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Restrict results to one package type",
     "enum": [
      "dependency",
      "dotnettool",
      "template"
     ]
    },
    {
     "name": "prerel",
     "in": "query",
     "required": false,
     "type": "boolean",
     "description": "Include prerelease versions",
     "default": true
    },
    {
     "name": "page",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Result page number, starting at 1",
     "example": "2"
    }
   ],
   "responseType": "html",
   "extract": {
    "list": "li.package",
    "fields": {
     "id": "a.package-title",
     "url": "a.package-title@href",
     "owners": "span.package-by",
     "totalDownloads": "li > span.icon-text",
     "lastUpdated": "li > span.icon-text > span",
     "tags": "li.package-tags",
     "description": "div.package-details",
     "frameworks": "div.framework-badges"
    }
   },
   "defaultFields": [
    "id",
    "url",
    "owners",
    "totalDownloads",
    "lastUpdated",
    "description",
    "tags"
   ],
   "pagination": {
    "type": "page",
    "param": "page"
   },
   "mutates": false,
   "example": {
    "q": "json"
   },
   "source": "E5 GET https://www.nuget.org/packages",
   "verified": true
  },
  {
