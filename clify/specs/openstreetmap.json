     "type": "string",
     "description": "OSM element type",
     "enum": [
      "node",
      "way",
      "relation"
     ],
     "example": "way"
    },
    {
     "name": "id",
     "in": "path",
     "required": true,
     "type": "number",
     "description": "Numeric OSM element id (osm_id from search-places)",
