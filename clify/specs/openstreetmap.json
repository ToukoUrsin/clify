  {
   "name": "search-places",
   "summary": "Geocode a place name or address with Nominatim, the search engine openstreetmap.org uses. Returns OSM type/id, coordinates and display name.",
   "method": "GET",
   "urlTemplate": "https://nominatim.openstreetmap.org/search?format=json",
   "params": [
    {
     "name": "q",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Free-text place name or address",
     "example": "Central Park, New York"
    },
    {
     "name": "api_limit",
     "key": "limit",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Maximum number of results (1-40) (sent to the site as \"limit\"; clify's own --limit only shapes the output)",
     "default": 10,
     "example": "10"
    },
    {
     "name": "viewbox",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Preferred area as minlon,minlat,maxlon,maxlat. Results inside it are ranked higher.",
     "example": "-74.0204,40.7563,-73.9106,40.8086"
    },
    {
     "name": "exclude_place_ids",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Comma-separated place_ids to exclude. Use it to get more results after a first page.",
     "example": "359156228"
    }
   ],
   "responseType": "json",
   "defaultFields": [
    "place_id",
    "osm_type",
    "osm_id",
    "name",
    "display_name",
    "lat",
    "lon",
    "class",
    "type"
   ],
   "mutates": false,
   "example": {
    "q": "Central Park, New York",
    "api_limit": "5"
   },
   "source": "E2 E8 E9 GET https://nominatim.openstreetmap.org/search",
   "verified": true
  },
  {
   "name": "get-element",
   "summary": "Get the detail page of an OSM node, way or relation: name, current version, last editor, changeset, edit comment and tags (as text).",
   "method": "GET",
   "urlTemplate": "/{element_type}/{id}",
   "params": [
    {
