{
  "name": "polymarket",
  "startUrl": "https://polymarket.com/",
  "origin": "https://polymarket.com",
  "createdAt": "2026-10-21T07:18:01.735Z",
  "description": "Polymarket prediction markets: search and list events and markets with live prices, volume, liquidity and end dates; price history, biggest movers, holders, comments, resolution status, and public trader profiles, positions and activity.",
  "commands": [
    {
      "name": "search-markets",
      "summary": "Full-text search of prediction events and their markets (current Yes/No prices, volume); sort by volume, liquidity, ending soon or competitive; active or resolved.",
      "method": "POST",
      "urlTemplate": "/api/search/execute",
      "params": [
        {
          "name": "query",
          "in": "body",
          "required": true,
          "type": "string",
          "description": "Search keywords, e.g. bitcoin",
          "example": "bitcoin"
        },
        {
          "name": "status",
          "in": "body",
          "required": false,
          "type": "string",
          "description": "Market status filter",
          "enum": [
            "active",
            "resolved"
          ],
          "default": "active"
        },
        {
          "name": "sort",
          "in": "body",
          "required": false,
          "type": "string",
          "description": "Sort order: volume, liquidity, ending_soon (nearest resolution date first), competitive (closest odds)",
          "enum": [
            "volume",
            "liquidity",
            "ending_soon",
            "competitive"
          ],
          "default": "volume"
        },
        {
          "name": "page",
          "in": "body",
          "required": false,
          "type": "number",
          "description": "Result page number, starting at 1",
          "default": 1
        }
      ],
      "bodyTemplate": {
        "params": {
          "searchMode": "query",
          "query": "{query}",
          "filters": {
            "status": "{status}",
            "sort": "{sort}"
          },
          "showFavorites": false,
          "optimized": false
        },
        "pageParam": "{page}",
        "locale": "en"
      },
      "bodyEncoding": "json",
      "responseType": "json",
      "resultPath": "results",
      "defaultFields": [
        "id",
        "title",
        "slug",
        "volume",
        "closed",
        "breadcrumbs.category.label",
        "markets"
      ],
      "pagination": {
        "type": "page",
        "param": "page"
      },
      "mutates": false,
      "example": {
        "query": "bitcoin",
        "sort": "volume"
      },
      "source": "E10 POST https://polymarket.com/api/search/execute",
      "sample": "{\"id\":\"89502\",\"title\":\"What price will Bitcoin hit in 2026?\",\"slug\":\"what-price-will-bitcoin-hit-before-2027\",\"volume\":76872561.23,\"closed\":false,\"breadcrumbs.category.label\":\"Crypto\",\"markets\":[{\"id\":\"1345531\",\"slug\":\"will-bitcoin-reach-90000-by-december-31-2026-113-862-581-343\",\"question\":\"Will Bitcoin reach $90,000 by December 31, 2026?\",\"outcomes\":[\"Yes\"",
      "resultFields": [
        "id",
        "title",
        "slug",
        "image",
        "closed",
        "archived",
        "volume",
        "commentCount",
        "eventCreators",
        "seriesSlug",
        "breadcrumbs",
        "tags",
        "markets"
      ],
      "verified": true
    },
    {
      "name": "list-events",
      "summary": "List events from the public Gamma API by category tag, ordered by volume or another field, with end dates, volume and liquidity; cursor paginated.",
      "method": "GET",
      "urlTemplate": "https://gamma-api.polymarket.com/events/keyset",
      "params": [
        {
          "name": "tag_slug",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Category or topic tag slug, e.g. crypto, sports, politics, esports, israel-election (see list-tags)",
          "example": "sports"
        },
        {
          "name": "closed",
          "in": "query",
          "required": false,
          "type": "boolean",
          "description": "false = open events only, true = closed or resolved events",
          "default": false
        },
        {
          "name": "order",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Field to order by, e.g. volume, volume24hr, liquidity, endDate, startDate",
          "default": "volume"
        },
        {
          "name": "ascending",
          "in": "query",
          "required": false,
          "type": "boolean",
          "description": "Sort ascending (true) or descending (false)",
          "default": false
        },
        {
          "name": "api_limit",
          "key": "limit",
          "in": "query",
          "required": false,
          "type": "number",
          "description": "Events per page (max 100) (sent to the site as \"limit\"; clify's own --limit only shapes the output)",
          "default": 50
        },
        {
          "name": "after_cursor",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Cursor from the previous page's next_cursor"
        }
      ],
      "responseType": "json",
      "resultPath": "events",
      "defaultFields": [
        "id",
        "slug",
        "title",
        "endDate",
        "volume",
        "volume24hr",
        "liquidity",
        "closed"
      ],
      "pagination": {
        "type": "cursor",
        "param": "after_cursor",
        "nextPath": "next_cursor"
      },
      "mutates": false,
      "example": {
        "tag_slug": "sports"
      },
