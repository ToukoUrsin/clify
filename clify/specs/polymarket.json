    {
      "name": "get-price-history",
      "summary": "Price history (probability 0-1 over time) of one outcome token; token ids come from a market's clobTokenIds.",
      "method": "GET",
      "urlTemplate": "https://data-api.polymarket.com/v2/prices-history",
      "params": [
        {
          "name": "token_id",
          "in": "query",
          "required": true,
          "type": "string",
          "description": "CLOB outcome token id (long decimal string from clobTokenIds)",
          "example": "93607174427076648497970085679890464224074212453553954883931612093962256690262"
        },
        {
          "name": "interval",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Time window",
          "enum": [
            "1h",
            "6h",
            "1d",
            "1w",
            "1m",
            "max"
          ],
          "default": "max"
        },
        {
          "name": "bucket_seconds",
          "in": "query",
          "required": false,
          "type": "number",
          "description": "Bucket size in seconds, e.g. 300 for 5-minute points (the UI uses it with interval 1d)"
        }
      ],
      "responseType": "json",
      "resultPath": "data",
      "defaultFields": [
        "timestamp",
        "price"
      ],
      "mutates": false,
      "example": {
        "token_id": "93607174427076648497970085679890464224074212453553954883931612093962256690262",
        "interval": "max"
      },
      "source": "E3 GET https://data-api.polymarket.com/v2/prices-history",
      "sample": "{\"timestamp\":1788739200,\"price\":0.495}",
      "resultFields": [
        "timestamp",
        "price",
        "resolution_seconds"
      ],
      "verified": true
    },
