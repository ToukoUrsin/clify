    {
      "name": "list-comments",
      "summary": "Latest comments on an event or series, newest first.",
      "method": "GET",
      "urlTemplate": "https://gamma-api.polymarket.com/comments?get_positions=true&get_reports=true&holders_only=false&order=createdAt&ascending=false",
      "params": [
        {
          "name": "parent_entity_type",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "What the id refers to",
          "enum": [
            "Event",
            "Series"
          ],
          "default": "Event"
        },
        {
          "name": "parent_entity_id",
          "in": "query",
          "required": true,
          "type": "string",
          "description": "Numeric event id (or series id when type is Series)",
          "example": "549019"
        },
        {
          "name": "api_limit",
          "key": "limit",
          "in": "query",
          "required": false,
          "type": "number",
          "description": "Comments per page (sent to the site as \"limit\"; clify's own --limit only shapes the output)",
          "default": 10
        },
        {
          "name": "offset",
          "in": "query",
          "required": false,
          "type": "number",
          "description": "Number of comments to skip",
          "default": 0
        }
      ],
      "responseType": "json",
      "defaultFields": [
        "id",
        "body",
        "profile.name",
        "userAddress",
        "createdAt",
        "reactionCount"
      ],
      "pagination": {
        "type": "offset",
        "param": "offset",
        "step": 10
      },
      "mutates": false,
      "example": {
