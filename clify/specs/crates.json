 "commands": [
  {
   "name": "search-crates",
   "summary": "Search or list crates by text query, with optional keyword/category/letter/user/team filters, sorting and pagination",
   "method": "GET",
   "urlTemplate": "/api/v1/crates",
   "params": [
    {
     "name": "q",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Free-text search query",
     "example": "http client"
    },
    {
     "name": "sort",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Sort order",
     "enum": [
      "relevance",
      "downloads",
      "recent-downloads",
      "recent-updates",
      "new",
      "alpha"
     ],
     "default": "relevance"
    },
    {
     "name": "all_keywords",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Space-separated keywords that every crate must have, e.g. 'serde'",
     "example": "serde"
    },
    {
     "name": "keyword",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Only crates tagged with this single keyword, e.g. 'cli'"
    },
    {
     "name": "category",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Only crates in this category slug, e.g. 'asynchronous' (see list-categories)"
