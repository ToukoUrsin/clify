  {
   "name": "list-traffic-messages",
   "summary": "List current road traffic messages (announcements, road works, weight restrictions, exempted transports) as GeoJSON features.",
   "method": "GET",
   "urlTemplate": "https://tie.digitraffic.fi/api/traffic-message/v1/messages?includeAreaGeometry=false",
   "params": [
    {
     "name": "situationType",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Message type",
     "enum": [
      "TRAFFIC_ANNOUNCEMENT",
      "EXEMPTED_TRANSPORT",
      "WEIGHT_RESTRICTION",
      "ROAD_WORK"
     ],
     "default": "TRAFFIC_ANNOUNCEMENT"
    },
    {
     "name": "inactiveHours",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Also include messages that ended within this many hours",
     "default": 0
    }
   ],
   "headers": {
    "Digitraffic-User": "clify"
   },
   "responseType": "json",
   "resultPath": "features",
   "defaultFields": [
    "properties.situationId",
    "properties.situationType",
    "properties.releaseTime",
    "properties.announcements.0.title",
    "properties.announcements.0.location.description"
   ],
   "mutates": false,
   "example": {
    "situationType": "TRAFFIC_ANNOUNCEMENT"
   },
   "source": "",
   "verified": true
  },
  {
   "name": "get-traffic-message",
