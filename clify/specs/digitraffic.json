    {
     "name": "station",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Station short code, e.g. HKI (Helsinki), TPE (Tampere)",
     "example": "HKI"
    },
    {
     "name": "arriving_trains",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Number of arriving trains",
     "default": 10
