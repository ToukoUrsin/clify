{
 "name": "digitraffic",
 "startUrl": "https://www.digitraffic.fi/",
 "origin": "https://www.digitraffic.fi",
 "createdAt": "2026-10-18T08:58:59.245Z",
 "description": "Digitraffic (Fintraffic) offers open, real-time Finnish road, rail and marine traffic data. This CLI wraps its public JSON APIs (tie/rata/meri.digitraffic.fi), the status page and the announcements (tiedotteet) pages.",
 "commands": [
  {
   "name": "list-announcements",
   "summary": "List Digitraffic announcements (tiedotteet), newest first. You can filter by traffic type or tag.",
   "method": "GET",
   "urlTemplate": "/tiedotteet/",
   "params": [
    {
     "name": "traffictype",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Traffic type filter",
     "enum": [
      "tieliikenne",
      "rautatieliikenne",
      "vesiliikenne"
     ],
     "example": "rautatieliikenne"
    },
    {
     "name": "tag",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Tag filter, e.g. rajapinnat",
     "example": "rajapinnat"
    }
   ],
   "responseType": "html",
   "extract": {
    "list": "div.posts-in-category__post",
    "fields": {
     "title": "a.posts-in-category__post-heading-link",
     "url": "a.posts-in-category__post-heading-link@href",
     "date": "span.date-type-tags__date",
     "trafficType": "li.date-type-tags__type a",
     "tag": "li.date-type-tags__tag a",
     "excerpt": "div.posts-in-category__excerpt"
    }
   },
   "defaultFields": [
    "title",
    "url",
    "date",
    "trafficType",
    "tag",
    "excerpt"
   ],
   "mutates": false,
   "source": "E8 E9 GET https://www.digitraffic.fi/tiedotteet/",
   "verified": true
  },
  {
   "name": "get-announcement",
   "summary": "Get the full text of one announcement by date and slug, as found in the URL /tiedotteet/YYYY/MM/DD/slug.html.",
   "method": "GET",
   "urlTemplate": "/tiedotteet/{year}/{month}/{day}/{slug}.html",
   "params": [
    {
     "name": "year",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Year, 4 digits",
     "example": "2026"
    },
    {
     "name": "month",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Month, 2 digits",
     "example": "08"
    },
    {
     "name": "day",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Day, 2 digits",
     "example": "18"
    },
    {
     "name": "slug",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Announcement slug without .html",
     "example": "road-datex2-3-7"
    }
   ],
   "responseType": "html",
   "extract": {
    "fields": {
     "title": "h1.h1--page-top",
     "date": "div.date-type-tags span.date-type-tags__date",
     "trafficType": "div.date-type-tags li.date-type-tags__type a",
     "tag": "div.date-type-tags li.date-type-tags__tag a",
     "body": "div.jekyll-content"
    }
   },
   "defaultFields": [
    "title",
    "date",
    "trafficType",
    "tag",
    "body"
   ],
   "mutates": false,
   "example": {
    "year": "2026",
    "month": "08",
    "day": "18",
    "slug": "road-datex2-3-7"
   },
   "source": "E10 E11 GET https://www.digitraffic.fi/tiedotteet/{n}/{n}/{n}/road-datex2-3-7.html",
   "verified": true
  },
