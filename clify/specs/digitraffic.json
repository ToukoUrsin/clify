    {
     "name": "departing_trains",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Number of departing trains",
     "default": 10
    },
    {
     "name": "arrived_trains",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Number of already arrived trains",
     "default": 0
