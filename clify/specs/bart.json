  "description": "BART (Bay Area Rapid Transit) website. The CLI lists stations and returns real-time departures, station timetables, service and elevator/escalator alerts, planned advisories, accessibility options, and routes, trips and fares from BART's public API.",
  "commands": [
    {
      "name": "get-departures",
      "summary": "Real-time departures (ETD) for a station: next trains per destination with minutes, platform, direction, length and line color (official BART API).",
      "method": "GET",
      "urlTemplate": "https://api.bart.gov/api/etd.aspx?cmd=etd&key=MW9S-E7SL-26DU-VV8V&json=y",
      "params": [
        {
          "name": "station",
          "key": "orig",
          "in": "query",
          "required": true,
          "type": "string",
          "description": "Uppercase 4-letter BART station code, e.g. EMBR, MONT, SFIA, 12TH",
          "example": "EMBR"
        },
        {
          "name": "platform",
          "key": "plat",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Only departures from this platform number (1-4)",
          "enum": [
            "1",
            "2",
            "3",
            "4"
          ]
        },
        {
          "name": "direction",
          "key": "dir",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Only northbound (n) or southbound (s) trains",
          "enum": [
            "n",
            "s"
          ]
        }
      ],
      "responseType": "json",
      "resultPath": "root.station.0.etd",
      "defaultFields": [
        "destination",
        "abbreviation",
        "limited",
        "estimate"
      ],
      "mutates": false,
      "example": {
        "station": "EMBR"
      },
      "source": "E7 E6 E84",
      "sample": "{\"destination\":\"Antioch\",\"abbreviation\":\"ANTC\",\"limited\":\"0\",\"estimate\":[{\"minutes\":\"25\",\"platform\":\"2\",\"direction\":\"North\",\"length\":\"9\",\"color\":\"YELLOW\",\"hexcolor\":\"#ffff33\",\"bikeflag\":\"1\",\"delay\":\"103\",\"cancelflag\":\"0\",\"dynamicflag\":\"0\"}]}",
      "resultFields": [
        "destination",
        "abbreviation",
        "limited",
        "estimate"
      ],
      "verified": true
    },
