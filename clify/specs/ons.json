    {
     "name": "series",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Bulletin series slug, e.g. consumerpriceinflation",
     "example": "consumerpriceinflation"
    },
    {
     "name": "edition",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Edition slug, e.g. august2026 (take it from list-bulletin-releases)",
