  {
   "name": "get-bulletin",
   "summary": "Get a statistical bulletin edition: title, summary, release and next-release dates, and its sections",
   "method": "GET",
   "urlTemplate": "https://api.beta.ons.gov.uk/v1/data?uri=/{topic}/bulletins/{series}/{edition}",
