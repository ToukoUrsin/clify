{
 "name": "ons",
 "startUrl": "https://www.ons.gov.uk/",
 "origin": "https://www.ons.gov.uk",
 "createdAt": "2026-10-18T08:40:47.542Z",
 "description": "Office for National Statistics (ons.gov.uk), the UK's official statistics site. This CLI searches publications and data, reads time series values and metadata, bulletins, datasets and the release calendar, and downloads CSV data. It is read-only and needs no login.",
 "commands": [
  {
   "name": "search",
   "summary": "Site-wide keyword search over ONS publications, bulletins, time series and datasets, with content-type and census topic filters, sorting and paging",
   "method": "GET",
   "urlTemplate": "/search",
   "params": [
    {
     "name": "q",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Search keywords",
     "example": "inflation"
    },
    {
     "name": "filter",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Content type filter. Examples: publications, bulletin, time_series, datasets, user_requested_data. The UI repeats this param when several are chosen.",
     "example": "time_series"
    },
    {
     "name": "topics",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Comma-separated census topic ids, e.g. 7779 (Census), 9731 (Ageing), 6646 (Demography)"
    },
    {
     "name": "sort",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Sort order",
     "enum": [
      "relevance",
      "release_date",
      "title"
     ],
     "default": "relevance"
    },
    {
     "name": "page",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Results page number (10 per page)",
     "default": 1
    }
   ],
   "responseType": "html",
   "extract": {
    "list": "ul.flush--padding > li.search__results__item",
    "fields": {
     "title": "h3 a || a",
     "url": "h3 a@href || a@href",
     "meta": "ul.ons-document-list__item-metadata",
     "text": ""
    }
   },
   "defaultFields": [
    "title",
    "url",
    "meta"
   ],
   "pagination": {
    "type": "page",
    "param": "page"
   },
   "mutates": false,
   "example": {
    "q": "inflation"
   },
   "source": "E9 GET https://www.ons.gov.uk/search",
   "verified": true
  },
  {
   "name": "search-timeseries",
   "summary": "Search the time series explorer (58k+ series) by keyword and/or topic path; each result shows the series ID (CDID) and dataset ID",
   "method": "GET",
   "urlTemplate": "/timeseriestool",
   "params": [
    {
     "name": "q",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Search keywords",
     "example": "unemployment"
    },
    {
     "name": "topic",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Restrict to a topic's time series, e.g. /economy/inflationandpriceindices/timeseries"
    },
    {
     "name": "sort",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Sort order",
     "enum": [
      "relevance",
      "release_date",
      "title"
     ]
    },
    {
     "name": "page",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Results page number",
     "default": 1
    }
   ],
   "responseType": "html",
   "extract": {
    "list": "ul.flush--padding > li.border-bottom.search__results__item",
    "fields": {
     "title": "h3 a || a",
     "url": "h3 a@href || a@href",
     "text": ""
    }
   },
   "defaultFields": [
    "title",
    "url",
    "text"
   ],
   "pagination": {
    "type": "page",
    "param": "page"
   },
   "mutates": false,
   "example": {
    "q": "unemployment"
   },
   "source": "E11 GET https://www.ons.gov.uk/timeseriestool",
   "verified": true
  },
  {
   "name": "get-timeseries",
   "summary": "Get time series metadata and its latest value (title, CDID, unit, latest period and value, release dates, source dataset) from the ONS content API",
   "method": "GET",
   "urlTemplate": "https://api.beta.ons.gov.uk/v1/data?uri=/{topic}/timeseries/{series_id}/{dataset}",
   "params": [
    {
     "name": "topic",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Topic path without leading/trailing slash, e.g. economy/inflationandpriceindices or employmentandlabourmarket/peoplenotinwork/unemployment. Take it from a search-timeseries result URL.",
     "example": "economy/inflationandpriceindices"
    },
    {
     "name": "series_id",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Series ID (CDID), lowercase, e.g. l55o, d7g7, mgsx",
     "example": "d7g7"
    },
    {
     "name": "dataset",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Source dataset ID, lowercase, e.g. mm23, lms",
     "example": "mm23"
    }
   ],
   "responseType": "json",
   "resultPath": "description",
   "defaultFields": [
    "title",
    "cdid",
    "datasetId",
    "date",
    "number",
    "unit",
    "releaseDate",
    "nextRelease"
   ],
   "mutates": false,
   "example": {
    "topic": "economy/inflationandpriceindices",
    "series_id": "d7g7",
    "dataset": "mm23"
   },
   "source": "E3 E4 E5 E6 E7",
   "verified": true
  },
  {
   "name": "get-timeseries-data",
   "summary": "Get the monthly observations of a time series as a list of {date, value} (for quarterly or annual-only series use download-timeseries-csv)",
   "method": "GET",
   "urlTemplate": "https://api.beta.ons.gov.uk/v1/data?uri=/{topic}/timeseries/{series_id}/{dataset}",
   "params": [
    {
     "name": "topic",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Topic path without leading/trailing slash, e.g. economy/inflationandpriceindices",
     "example": "economy/inflationandpriceindices"
    },
    {
     "name": "series_id",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Series ID (CDID), lowercase",
     "example": "l55o"
    },
    {
     "name": "dataset",
     "in": "path",
     "required": true,
     "type": "string",
     "description": "Source dataset ID, lowercase",
     "example": "mm23"
    }
   ],
   "responseType": "json",
   "resultPath": "months",
   "defaultFields": [
    "date",
    "value",
    "updateDate"
   ],
   "mutates": false,
   "example": {
    "topic": "economy/inflationandpriceindices",
    "series_id": "l55o",
    "dataset": "mm23"
   },
   "source": "E2 E4 E8",
   "verified": true
  },
  {
   "name": "download-timeseries-csv",
   "summary": "Download a time series as CSV with all frequencies (annual, quarterly, monthly) plus metadata rows; also works for a previous version",
   "method": "GET",
   "urlTemplate": "/generator?format=csv",
   "params": [
    {
     "name": "uri",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Time series URI path, e.g. /economy/inflationandpriceindices/timeseries/l55o/mm23. Append /previous/vN for a superseded version.",
     "example": "/economy/inflationandpriceindices/timeseries/l55o/mm23"
    }
   ],
   "responseType": "text",
   "mutates": false,
   "example": {
    "uri": "/economy/inflationandpriceindices/timeseries/l55o/mm23"
   },
   "source": "E13 E21 GET https://www.ons.gov.uk/economy/inflationandpriceindices/timeseries/l55o/mm23",
   "verified": true
  },
