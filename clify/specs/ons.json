  {
   "name": "list-releases",
   "summary": "List the release calendar (published, upcoming or cancelled releases) with keyword search, sorting and paging, read from the RSS feed",
   "method": "GET",
   "urlTemplate": "/releasecalendar?rss",
   "params": [
    {
     "name": "keywords",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Keyword search, e.g. gdp",
     "example": "gdp"
    },
    {
     "name": "release_type",
     "key": "release-type",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Release status",
     "enum": [
      "type-published",
      "type-upcoming",
      "type-cancelled"
     ],
     "default": "type-published",
     "example": "type-upcoming"
    },
    {
     "name": "sort",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Sort order",
     "enum": [
      "date-newest",
      "date-oldest",
      "alphabetical-az",
      "alphabetical-za",
      "relevance"
     ],
     "default": "date-newest"
    },
    {
     "name": "api_limit",
     "key": "limit",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Results per page (sent to the site as \"limit\"; clify's own --limit only shapes the output)",
     "default": 10
    },
    {
     "name": "page",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Page number",
     "default": 1
    }
   ],
   "responseType": "json",
   "resultPath": "rss.channel.item",
   "defaultFields": [
