    {
     "name": "query",
     "in": "body",
     "required": true,
     "type": "string",
     "description": "Search keywords",
     "example": "vpc"
    },
    {
     "name": "index",
     "in": "body",
     "required": false,
     "type": "string",
     "description": "Which registry index to search",
     "enum": [
      "providers",
      "modules",
      "provider-docs",
      "policy-libraries",
      "run-tasks"
     ],
     "default": "providers",
     "example": "providers"
    },
    {
     "name": "page",
     "in": "body",
     "required": false,
     "type": "number",
     "description": "Zero-based result page",
     "default": 0
    },
    {
     "name": "hits_per_page",
     "in": "body",
     "required": false,
     "type": "number",
     "description": "Results per page",
     "default": 20
    }
   ],
   "bodyTemplate": {
    "requests": [
     {
      "indexName": "tf-registry:prod:{index}",
      "query": "{query}",
      "type": "default",
      "page": "{page}",
      "hitsPerPage": "{hits_per_page}",
      "getRankingInfo": false
     }
    ]
   },
   "bodyEncoding": "json",
   "headers": {
    "content-type": "text/plain"
   },
   "responseType": "json",
   "resultPath": "results.0.hits",
   "defaultFields": [
    "objectID",
    "full-name",
    "namespace",
    "name",
    "description",
    "tier",
    "downloads",
    "latest-version"
   ],
   "pagination": {
    "type": "page",
    "param": "page"
   },
   "mutates": false,
   "example": {
    "query": "kubernetes",
    "index": "providers"
   },
   "source": "E6 POST https://yy0ffni7mf-dsn.algolia.net/{n}/indexes/*/queries",
