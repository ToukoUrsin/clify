    {
      "name": "search-events",
      "summary": "List upcoming events in a place, filtered by category tag and date range. Returns name, URL, date, venue and lowest price.",
      "method": "POST",
      "urlTemplate": "/api/v3/destination/search/",
      "params": [
        {
          "name": "placeId",
          "key": "places",
          "in": "body",
          "required": false,
          "type": "string",
          "description": "Eventbrite place id of the city (San Francisco = 85922583).",
          "default": "85922583",
          "example": "85922583"
        },
        {
          "name": "tag",
          "key": "tags",
          "in": "body",
          "required": false,
          "type": "string",
          "description": "Category tag. Examples: EventbriteCategory/102 = Science & Tech, EventbriteSubCategory/2004 = High Tech, EventbriteCategory/101 = Business, EventbriteSubCategory/1001 = Startups & Small Business.",
          "default": "EventbriteCategory/102",
          "example": "EventbriteCategory/102"
        },
        {
          "name": "dates",
          "in": "body",
          "required": false,
          "type": "string",
          "description": "Date range keyword.",
          "enum": [
            "current_future",
            "today",
            "tomorrow",
            "this_weekend",
            "this_week",
            "this_4_weeks"
          ],
          "default": "current_future"
        },
        {
          "name": "online_only",
          "key": "online_events_only",
          "in": "body",
          "required": false,
          "type": "boolean",
          "description": "Only online events.",
          "default": false
        },
        {
          "name": "sort",
          "in": "body",
          "required": false,
          "type": "string",
          "description": "Sort order. 'date' gives soonest first.",
          "default": "date"
        },
        {
          "name": "page_size",
          "in": "body",
          "required": false,
          "type": "number",
          "description": "Results per page (max 100).",
          "default": 50
        },
        {
          "name": "page",
          "in": "body",
          "required": false,
          "type": "number",
          "description": "Page number, starting at 1.",
          "default": 1
        }
      ],
      "bodyTemplate": {
        "browse_surface": "TTD",
        "event_search": {
          "page_size": "{page_size}",
          "page": "{page}",
          "exclude": {
            "ids": []
