          "tags": [
            "{tag}"
          ],
          "online_events_only": "{online_only}",
          "places": [
            "{placeId}"
          ],
          "sort": "{sort}",
          "include_manual_events": true,
          "include_mature_events": true
        },
        "expand.destination_event": [
          "primary_venue",
          "image",
          "ticket_availability",
          "saves",
          "event_sales_status",
          "primary_organizer",
          "public_collections"
        ]
      },
      "bodyEncoding": "json",
