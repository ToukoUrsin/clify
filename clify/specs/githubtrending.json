  "commands": [
    {
      "name": "list-trending-repos",
      "summary": "List GitHub trending repositories for a period (daily/weekly/monthly) and programming language, with description, language, total stars, forks and stars gained in the period.",
      "method": "GET",
      "urlTemplate": "/trending/{language}",
      "params": [
        {
          "name": "language",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "Programming language slug as used in GitHub URLs, lowercase, e.g. python, javascript, rust, c%23 for C#.",
          "example": "python"
        },
        {
          "name": "since",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Trending period",
          "enum": [
            "daily",
            "weekly",
            "monthly"
          ],
          "default": "daily",
          "example": "weekly"
        },
        {
          "name": "spoken_language_code",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Filter by spoken language of the repo, ISO 639-1 code, e.g. en, zh"
        }
      ],
      "responseType": "html",
      "extract": {
        "list": "article.Box-row",
        "fields": {
          "name": "h2 a",
          "url": "h2 a@href",
          "description": "p",
          "language": "span[itemprop=programmingLanguage]",
          "stars": "a.Link--muted",
          "forks": "a.Link--muted ~ a.Link--muted",
          "starsInPeriod": "span.float-sm-right"
        }
      },
      "defaultFields": [
        "name",
        "url",
        "description",
        "language",
        "stars",
        "forks",
        "starsInPeriod"
      ],
      "mutates": false,
      "example": {
        "since": "daily",
        "language": "python"
      },
      "source": "E20",
      "sample": "{\"name\":\"MadsLorentzen / ai-job-search\",\"url\":\"https://github.com/MadsLorentzen/ai-job-search\",\"description\":\"The job search that runs on your machine. AI job application framework built on Claude Code: evaluate postings, tailor CVs, write cover letters, prep interviews. Fork it and own it.\",\"language\":\"Python\",\"stars\":\"https://github.com/trending/61,467\",\"f",
      "resultFields": [
        "name",
        "url",
        "description",
        "language",
        "stars",
        "forks",
        "starsInPeriod"
      ],
      "verified": true
    },
