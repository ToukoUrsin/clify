   "params": [
    {
     "name": "q",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Station or place name to search for",
     "example": "Boston"
    }
   ],
   "responseType": "json",
   "resultPath": "stationList",
   "defaultFields": [
    "stationId",
    "stationFullName",
    "state",
    "region",
    "lat",
    "lon",
    "stationType",
    "refStationId"
   ],
   "mutates": false,
   "example": {
    "q": "Boston"
   },
   "source": "E29 GET https://api.tidesandcurrents.noaa.gov/mdapi/prod/webapi/tidepredstations.json",
   "verified": true
  },
  {
