  {
   "name": "get-tide-predictions",
   "summary": "Get tide predictions for a station: high/low times and heights or a regular time series, for a date or date range",
   "method": "GET",
   "urlTemplate": "https://api.tidesandcurrents.noaa.gov/api/prod/datagetter?product=predictions&format=json&application=NOS.COOPS.TAC.STATIONHOME",
   "params": [
    {
     "name": "station",
     "in": "query",
     "required": true,
     "type": "string",
     "description": "Tide prediction station ID",
     "example": "9447130"
    },
    {
     "name": "date",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Relative date: today, latest or recent. Use this OR begin_date/end_date OR range.",
     "enum": [
      "today",
      "latest",
      "recent"
     ],
     "example": "today"
    },
    {
     "name": "begin_date",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Start date, yyyyMMdd or 'yyyyMMdd HH:mm'",
     "example": "20261017"
    },
    {
     "name": "end_date",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "End date, yyyyMMdd or 'yyyyMMdd HH:mm'",
     "example": "20261018"
    },
    {
     "name": "range",
     "in": "query",
     "required": false,
     "type": "number",
     "description": "Number of hours (used with begin_date or end_date, or alone for the last N hours)"
    },
    {
     "name": "interval",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "hilo = high/low tides only; h = hourly; or minutes",
     "enum": [
      "hilo",
      "h",
      "1",
      "5",
      "6",
      "10",
      "15",
      "30",
      "60"
     ],
     "default": "hilo"
    },
    {
     "name": "datum",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "Vertical datum",
     "enum": [
      "MLLW",
      "MLW",
      "MSL",
      "MTL",
      "MHW",
      "MHHW",
      "NAVD",
      "STND"
     ],
     "default": "MLLW"
    },
    {
     "name": "units",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "english (feet) or metric (meters)",
     "enum": [
      "english",
      "metric"
     ],
     "default": "english"
    },
    {
     "name": "time_zone",
     "in": "query",
     "required": false,
     "type": "string",
     "description": "gmt, lst (local standard) or lst_ldt (local with daylight saving)",
     "enum": [
      "gmt",
      "lst",
      "lst_ldt"
     ],
     "default": "lst_ldt"
    }
   ],
   "responseType": "json",
   "resultPath": "predictions",
   "defaultFields": [
    "t",
    "v",
    "type"
   ],
   "mutates": false,
   "example": {
    "station": "9447130",
    "date": "today"
   },
   "source": "E8 GET https://api.tidesandcurrents.noaa.gov/api/prod/datagetter",
   "verified": true
  },
