  "description": "Lever-hosted company job boards (jobs.lever.co/{company}): list and filter a company's open postings by location, team, work type and workplace type, and fetch posting details with apply links via Lever's public postings API.",
  "commands": [
    {
      "name": "list-postings",
      "summary": "List a company's open job postings on Lever, optionally filtered by location, team, department, commitment (work type) or workplace type; returns title, location, team, apply link.",
      "method": "GET",
      "urlTemplate": "https://api.lever.co/v0/postings/{company}?mode=json",
      "params": [
        {
          "name": "company",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "Company slug as in jobs.lever.co/{company}, e.g. palantir, spotify. A 404 means the company doesn't use Lever.",
          "example": "palantir"
        },
        {
          "name": "location",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Exact location label as shown on the board, e.g. 'New York, NY'. Take values from categories.location in unfiltered results.",
          "example": "New York, NY"
        },
        {
          "name": "team",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Exact team label, e.g. 'Software Engineering'. Take values from categories.team.",
          "example": "Software Engineering"
        },
        {
          "name": "department",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Exact department label (categories.department)."
        },
        {
          "name": "commitment",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Work type label, e.g. Full-time, Internship, Fixed-Term, Permanent (varies by company; see categories.commitment).",
          "example": "Full-time"
        },
        {
          "name": "workplaceType",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Workplace type.",
          "enum": [
            "onsite",
            "hybrid",
            "remote"
          ]
        },
        {
          "name": "api_limit",
          "key": "limit",
          "in": "query",
          "required": false,
          "type": "number",
          "description": "Max postings per page. (sent to the site as \"limit\"; clify's own --limit only shapes the output)",
          "default": 100
        },
        {
          "name": "skip",
          "in": "query",
          "required": false,
          "type": "number",
          "description": "Number of postings to skip (offset for paging)."
        }
      ],
      "responseType": "json",
      "defaultFields": [
        "id",
        "text",
        "categories.location",
        "categories.team",
        "categories.commitment",
        "workplaceType",
        "hostedUrl",
        "applyUrl"
      ],
      "pagination": {
        "type": "offset",
        "param": "skip",
        "step": 100
      },
      "mutates": false,
      "example": {
