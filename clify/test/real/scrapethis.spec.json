{
  "name": "scrapethis",
  "startUrl": "https://www.scrapethissite.com/pages/",
  "origin": "https://www.scrapethissite.com",
  "createdAt": "2026-10-17T08:45:00Z",
  "description": "Scrape This Site (scraping sandbox): Oscar-winning films by year (JSON) and a searchable, paginated hockey-team stats table.",
  "commands": [
    { "name": "oscar-films", "summary": "Oscar-winning films for a year (2010-2015)", "method": "GET", "urlTemplate": "/pages/ajax-javascript/?ajax=true", "responseType": "json", "mutates": false,
      "params": [ { "name": "year", "in": "query", "required": true, "type": "string", "enum": ["2010", "2011", "2012", "2013", "2014", "2015"] } ],
      "example": { "year": "2015" }, "source": "GET https://www.scrapethissite.com/pages/ajax-javascript/?ajax=true&year=2015 (xhr)" },
    { "name": "search-teams", "summary": "Hockey team seasons by team name", "method": "GET", "urlTemplate": "/pages/forms/", "responseType": "html", "mutates": false,
      "params": [ { "name": "q", "in": "query", "required": true, "type": "string", "description": "team name text, e.g. new york" },
                  { "name": "page_num", "in": "query", "required": false, "type": "number" },
                  { "name": "per_page", "in": "query", "required": false, "type": "number", "description": "25, 50 or 100" } ],
      "extract": { "list": "tr.team", "fields": { "name": "td.name", "year": "td.year", "wins": "td.wins", "losses": "td.losses", "winPct": "td.pct", "goalsFor": "td.gf", "goalsAgainst": "td.ga" } },
      "example": { "q": "new york" }, "source": "GET https://www.scrapethissite.com/pages/forms/?q=new+york" }
  ]
}
