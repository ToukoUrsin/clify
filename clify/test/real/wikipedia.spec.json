      "example": { "title": "Y_Combinator" }, "source": "GET https://en.wikipedia.org/api/rest_v1/page/summary/Y_Combinator" },
    { "name": "article", "summary": "Article headings and lead paragraphs", "method": "GET", "urlTemplate": "/wiki/{title}", "responseType": "html", "mutates": false,
      "params": [ { "name": "title", "in": "path", "required": true, "type": "string", "description": "e.g. Hacker_News" } ],
      "extract": { "fields": { "title": "h1#firstHeading", "lead": "#mw-content-text p:not(.mw-empty-elt)" } },
      "example": { "title": "Hacker_News" }, "source": "GET https://en.wikipedia.org/wiki/Hacker_News" },
    { "name": "random", "summary": "Summary of a random article", "method": "GET", "urlTemplate": "/api/rest_v1/page/random/summary", "responseType": "json", "mutates": false, "params": [] }
