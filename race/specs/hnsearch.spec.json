  "createdAt": "2026-10-18T06:40:00Z",
  "description": "Hacker News search (hn.algolia.com) through its documented public API. search ranks by relevance then popularity; numericFilters narrows by date or points.",
  "commands": [
    { "name": "search", "summary": "Search stories/comments (relevance, then points)", "method": "GET", "urlTemplate": "/api/v1/search", "responseType": "json", "resultPath": "hits", "mutates": false,
      "params": [
        { "name": "query", "in": "query", "required": true, "type": "string" },
        { "name": "tags", "in": "query", "required": false, "type": "string", "enum": ["story", "comment", "ask_hn", "show_hn", "poll"], "default": "story" },
        { "name": "numericFilters", "in": "query", "required": false, "type": "string", "description": "comma-separated, e.g. created_at_i>=1735689600,created_at_i<1767225600 or points>100" },
        { "name": "hitsPerPage", "in": "query", "required": false, "type": "number" },
        { "name": "page", "in": "query", "required": false, "type": "number" } ],
      "example": { "query": "sqlite", "numericFilters": "points>500" } },
    { "name": "search-by-date", "summary": "Newest first", "method": "GET", "urlTemplate": "/api/v1/search_by_date", "responseType": "json", "resultPath": "hits", "mutates": false,
      "params": [
        { "name": "query", "in": "query", "required": true, "type": "string" },
        { "name": "tags", "in": "query", "required": false, "type": "string", "enum": ["story", "comment", "ask_hn", "show_hn", "poll"], "default": "story" },
        { "name": "numericFilters", "in": "query", "required": false, "type": "string" },
        { "name": "hitsPerPage", "in": "query", "required": false, "type": "number" } ] },
    { "name": "get-item", "summary": "A story or comment with its comment tree", "method": "GET", "urlTemplate": "/api/v1/items/{id}", "responseType": "json", "mutates": false,
      "params": [ { "name": "id", "in": "path", "required": true, "type": "number" } ] }
  ]
}
