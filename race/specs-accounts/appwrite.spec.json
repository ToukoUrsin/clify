  "description": "Appwrite Cloud console, signed in as the clify agent (saved session). Project resources live on the project's region host: pass --region (from list-projects) and --x-appwrite-project <project id>.",
  "auth": { "headerNames": [] },
  "commands": [
    { "name": "list-projects", "summary": "Your projects ($id, name, region)", "method": "GET", "urlTemplate": "https://cloud.appwrite.io/v1/projects", "headers": { "x-appwrite-project": "console" }, "responseType": "json", "resultPath": "projects", "mutates": false, "auth": true, "params": [], "source": "GET https://cloud.appwrite.io/v1/projects" },
    { "name": "list-databases", "summary": "Databases in a project", "method": "GET", "urlTemplate": "https://{region}.cloud.appwrite.io/v1/tablesdb", "headers": { "x-appwrite-mode": "admin" }, "responseType": "json", "resultPath": "databases", "mutates": false, "auth": true,
      "params": [ { "name": "region", "in": "path", "required": true, "type": "string", "example": "fra" }, { "name": "x-appwrite-project", "in": "header", "required": true, "type": "string", "description": "project $id" } ], "source": "GET https://fra.cloud.appwrite.io/v1/tablesdb" },
    { "name": "list-tables", "summary": "Tables in a database", "method": "GET", "urlTemplate": "https://{region}.cloud.appwrite.io/v1/tablesdb/{database}/tables", "headers": { "x-appwrite-mode": "admin" }, "responseType": "json", "resultPath": "tables", "mutates": false, "auth": true,
      "params": [ { "name": "region", "in": "path", "required": true, "type": "string" }, { "name": "database", "in": "path", "required": true, "type": "string", "description": "database $id" }, { "name": "x-appwrite-project", "in": "header", "required": true, "type": "string" } ], "source": "GET https://fra.cloud.appwrite.io/v1/tablesdb/<db>/tables" },
    { "name": "create-table", "summary": "Create a table (ID generated by Appwrite)", "method": "POST", "urlTemplate": "https://{region}.cloud.appwrite.io/v1/tablesdb/{database}/tables", "headers": { "x-appwrite-mode": "admin" }, "responseType": "json", "bodyEncoding": "json", "mutates": true, "auth": true,
      "bodyTemplate": { "tableId": "unique()", "name": "{name}" },
      "params": [ { "name": "region", "in": "path", "required": true, "type": "string" }, { "name": "database", "in": "path", "required": true, "type": "string" }, { "name": "x-appwrite-project", "in": "header", "required": true, "type": "string" }, { "name": "name", "in": "body", "required": true, "type": "string" } ], "source": "POST https://fra.cloud.appwrite.io/v1/tablesdb/<db>/tables" },
    { "name": "create-string-column", "summary": "Add a string column to a table", "method": "POST", "urlTemplate": "https://{region}.cloud.appwrite.io/v1/tablesdb/{database}/tables/{table}/columns/string", "headers": { "x-appwrite-mode": "admin" }, "responseType": "json", "bodyEncoding": "json", "mutates": true, "auth": true,
      "params": [ { "name": "region", "in": "path", "required": true, "type": "string" }, { "name": "database", "in": "path", "required": true, "type": "string" }, { "name": "table", "in": "path", "required": true, "type": "string", "description": "table $id" }, { "name": "x-appwrite-project", "in": "header", "required": true, "type": "string" },
        { "name": "key", "in": "body", "required": true, "type": "string", "description": "column name" }, { "name": "size", "in": "body", "required": true, "type": "number" }, { "name": "required", "in": "body", "required": true, "type": "boolean" } ], "source": "POST https://fra.cloud.appwrite.io/v1/tablesdb/<db>/tables/<table>/columns/string" },
    { "name": "list-columns", "summary": "A table's columns", "method": "GET", "urlTemplate": "https://{region}.cloud.appwrite.io/v1/tablesdb/{database}/tables/{table}/columns", "headers": { "x-appwrite-mode": "admin" }, "responseType": "json", "resultPath": "columns", "mutates": false, "auth": true,
      "params": [ { "name": "region", "in": "path", "required": true, "type": "string" }, { "name": "database", "in": "path", "required": true, "type": "string" }, { "name": "table", "in": "path", "required": true, "type": "string" }, { "name": "x-appwrite-project", "in": "header", "required": true, "type": "string" } ], "source": "GET https://fra.cloud.appwrite.io/v1/tablesdb/<db>/tables/<table>/columns" }
  ]
