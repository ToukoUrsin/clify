          "description": "Project id",
          "example": "6ad465aa0026dab1fac0",
          "context": "projectId"
        },
        {
          "name": "databaseId",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "Database id",
          "example": "6ad471f2900e99d2b0e4",
          "context": "databaseId"
        },
        {
          "name": "tableId",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "Table id",
          "example": "6ad4947000260c96461e"
        },
        {
          "name": "key",
          "in": "body",
          "required": true,
          "type": "string",
          "description": "Column key (name), e.g. title",
          "example": "race_gen_2"
        },
        {
          "name": "size",
          "in": "body",
          "required": false,
          "type": "number",
          "description": "Maximum length in characters",
          "default": 255
        },
        {
          "name": "required",
          "in": "body",
          "required": false,
          "type": "boolean",
          "description": "Whether rows must provide a value",
          "default": false
        },
        {
          "name": "array",
          "in": "body",
          "required": false,
          "type": "boolean",
          "description": "Whether the column holds an array of strings",
          "default": false
        },
        {
          "name": "encrypt",
          "in": "body",
