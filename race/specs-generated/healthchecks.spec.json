  "description": "Healthchecks.io is a cron job monitoring service. This CLI lists your projects and checks, creates and edits checks (name, tags, period, grace), and can pause, ping, delete and inspect them.",
  "commands": [
    {
      "name": "list-checks",
      "summary": "List the checks in a project, with name, status icon and details URL. Optionally filter by tag and sort.",
      "method": "GET",
      "urlTemplate": "/projects/{projectId}/checks/",
      "params": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "Project UUID (see list-projects)",
          "example": "0d103ac6-8389-4868-8f5f-944911961863",
          "context": "projectId"
        },
        {
          "name": "tag",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Only show checks that have this tag",
          "example": "backup"
        },
        {
          "name": "sort",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Sort order. A leading '-' means descending.",
          "enum": [
            "name",
            "-name",
            "last_ping",
            "-last_ping",
            "created"
          ]
        }
      ],
      "responseType": "html",
      "extract": {
        "list": "tr.checks-row",
        "fields": {
          "name": "div.my-checks-name",
          "status": "span.status@class",
          "url": "a.btn@href"
        }
      },
      "defaultFields": [
        "name",
        "status",
        "url"
      ],
      "mutates": false,
      "auth": true,
      "example": {},
      "source": "E11 GET https://healthchecks.io/projects/{id}/checks/",
      "verified": true,
      "sample": "{\"name\":\"My First Check\",\"status\":\"status ic-new\",\"url\":\"https://healthchecks.io/checks/32aeab82-e185-4901-9e68-458a739fb02d/details/\"}",
      "resultFields": [
        "name",
        "status",
        "url"
      ]
    },
    {
      "name": "add-check",
      "summary": "Create a new simple (period-based) check in a project with name, tags, period and grace time. Returns the project's check list.",
      "method": "POST",
      "urlTemplate": "/projects/{projectId}/checks/add/",
      "params": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "Project UUID",
          "example": "0d103ac6-8389-4868-8f5f-944911961863",
          "context": "projectId"
        },
        {
          "name": "name",
          "in": "body",
          "required": true,
          "type": "string",
          "description": "Human-friendly check name",
          "example": "nightly-backup"
        },
        {
          "name": "tags",
          "in": "body",
          "required": false,
          "type": "string",
          "description": "Tags separated by spaces, e.g. 'backup nightly'",
          "example": "backup nightly"
        },
        {
          "name": "timeout",
          "in": "body",
          "required": false,
          "type": "number",
          "description": "Period: the expected time between pings, in seconds (e.g. 86400 for one day)",
          "default": 86400,
          "example": "7200"
        },
        {
          "name": "grace",
          "in": "body",
          "required": false,
          "type": "number",
          "description": "Grace time in seconds: how long to wait after a missed ping before alerting",
          "default": 3600,
          "example": "1800"
        },
        {
          "name": "slug",
          "in": "body",
          "required": false,
          "type": "string",
          "description": "Optional custom slug for slug-style ping URLs"
        }
      ],
      "bodyTemplate": {
        "name": "{name}",
        "slug": "{slug}",
        "tags": "{tags}",
        "timeout": "{timeout}",
        "grace": "{grace}",
        "kind": "simple",
        "tz": "UTC"
      },
      "bodyEncoding": "form",
      "responseType": "html",
      "extract": {
        "list": "tr.checks-row",
        "fields": {
          "name": "div.my-checks-name",
          "status": "span.status@class",
