    {
      "name": "list-category-topics",
      "summary": "List topics in one category, newest activity first by default, with optional sort and paging. posters[] gives user ids; the entry whose description contains 'Original Poster' is the starter.",
      "method": "GET",
      "urlTemplate": "/c/{slug}/{id}/l/latest.json?filter=default",
      "params": [
        {
          "name": "slug",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "Category slug from list-categories, e.g. support, bug",
          "example": "support"
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "number",
          "description": "Category numeric id from list-categories (support=6, bug=7)",
          "example": "6"
        },
        {
          "name": "order",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Sort column. Omit for latest activity.",
          "enum": [
            "activity",
            "views",
            "posts",
            "created",
            "likes",
            "op_likes",
            "posters"
          ]
        },
        {
          "name": "ascending",
          "in": "query",
          "required": false,
          "type": "boolean",
          "description": "Sort ascending when true. The UI sends false together with order."
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "type": "number",
          "description": "0-based page number. Page 1 is the second page. Each page has about 30 topics."
        }
      ],
      "responseType": "json",
      "resultPath": "topic_list.topics",
      "defaultFields": [
        "id",
        "slug",
        "title",
        "created_at",
        "last_posted_at",
