  "description": "updown.io is a website uptime monitoring service. This CLI lists your checks, adds or updates HTTP/HTTPS checks, and reads check details, downtimes and status pages.",
  "commands": [
    {
      "name": "list-checks",
      "summary": "List your monitoring checks with alias, target URL, status and check interval. Optionally search and sort.",
      "method": "GET",
      "urlTemplate": "/checks",
      "params": [
        {
          "name": "q",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Search text matched against the check URL or alias",
          "example": "example"
        },
        {
          "name": "order",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Sort order of the list",
          "enum": [
            "alias",
            "status"
          ]
        }
      ],
      "responseType": "html",
      "extract": {
        "list": "section#checks ul.list > li.https, section#checks ul.list > li.http",
        "fields": {
          "url": "a.internal@href",
          "alias": "span.alias",
          "target": "a.external@href",
          "scheme": "div.link span.scheme",
          "status": "div.status",
          "period": "div.resolution",
          "periodDescription": "div.resolution@title",
          "statusPage": "a.status-page@href"
        }
      },
      "defaultFields": [
        "url",
        "alias",
        "target",
        "status",
        "period",
        "statusPage"
      ],
      "mutates": false,
      "auth": true,
      "source": "E4 GET https://updown.io/checks",
      "verified": true,
      "sample": "{\"url\":\"https://updown.io/checks/ygm8\",\"alias\":\"Book club site (example.org)\",\"target\":\"https://example.org\",\"status\":\"200 OK\",\"period\":\"1 hr\",\"statusPage\":\"https://updown.io/ygm8\"}",
      "resultFields": [
        "url",
        "alias",
        "target",
        "scheme",
        "status",
        "period",
        "periodDescription",
        "statusPage"
      ],
      "example": {}
    },
    {
