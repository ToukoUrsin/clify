    {
      "name": "get-check",
      "summary": "Show a check's detail page: alias, latest result, next scheduled check, yearly SLA and downtime summary.",
      "method": "GET",
      "urlTemplate": "/checks/{token}",
      "params": [
        {
          "name": "token",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "Check token, the last segment of the check url from list-checks (/checks/<token>)",
          "example": "e3l3"
        },
        {
          "name": "range",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "Statistics range; 'months' shows the long-term (10 years) view instead of 60 days",
          "enum": [
            "months"
          ]
