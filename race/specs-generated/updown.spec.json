          "lastResult": "div.results a.result span.details",
          "lastResultUrl": "div.results a.result@href",
          "slaYear": "div.heatmap.sla span.pct",
          "downtimes": "div.empty-state p"
        }
      },
      "defaultFields": [
        "alias",
        "nextCheck",
        "lastResultTime",
        "lastResult",
        "slaYear",
